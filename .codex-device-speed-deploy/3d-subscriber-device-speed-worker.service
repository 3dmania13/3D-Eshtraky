[Unit]
Description=Subscriber per-device speed enforcement worker
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=three-d-subscriber-api
Group=three-d-subscriber-api
WorkingDirectory=/opt/3d-subscriber-api/releases/20260922-push
EnvironmentFile=/etc/3d-subscriber-api/3d-subscriber-notifications.env
ExecStart=/opt/3d-subscriber-api/runtime/bin/node /opt/3d-subscriber-api/releases/20260922-push/dist/devices/device-speed-worker-main.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
MemoryHigh=128M
MemoryMax=192M
CPUQuota=25%
TasksMax=100
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
