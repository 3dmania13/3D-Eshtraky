<?php
declare(strict_types=1);

include 'library/checklogin.php';
$operator = (string) $_SESSION['operator_user'];
include_once '../common/includes/config_read.php';
$operator_perm_file = 'config_operators_list';
include 'library/check_operator_perm.php';
include_once 'lang/main.php';
include_once '../common/includes/validation.php';
include '../common/includes/layout.php';
include_once 'include/nawa/functions.php';
include '../common/includes/db_open.php';

$dbSocket->setErrorHandling(PEAR_ERROR_RETURN);
$fragmentMode = isset($_GET['fragment']) && $_GET['fragment'] === '1';
$ajaxMode = $_SERVER['REQUEST_METHOD'] === 'POST' && isset($_GET['ajax']);
$successMsg = '';
$failureMsg = '';

$operatorsTable = $configValues['CONFIG_DB_TBL_DALOOPERATORS'];
$aclTable = $configValues['CONFIG_DB_TBL_DALOOPERATORS_ACL'];
$aclFilesTable = $configValues['CONFIG_DB_TBL_DALOOPERATORS_ACL_FILES'];

function nawa_operator_json(int $status, bool $ok, string $message): void
{
    http_response_code($status);
    header('Content-Type: application/json; charset=UTF-8');
    header('Cache-Control: no-store');
    echo json_encode(['ok' => $ok, 'message' => $message], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);
    exit;
}

function nawa_operator_acl_files($dbSocket, string $table): array
{
    $result = $dbSocket->query("SELECT file, category, section FROM `{$table}` ORDER BY category, section, id");
    if (DB::isError($result)) {
        return [];
    }
    $files = [];
    while ($row = $result->fetchRow(DB_FETCHMODE_ASSOC)) {
        $file = (string) ($row['file'] ?? '');
        if ($file !== '' && preg_match('/\A[A-Za-z0-9_]+\z/D', $file) === 1) {
            $files[$file] = [
                'category' => (string) ($row['category'] ?? 'Other'),
                'section' => (string) ($row['section'] ?? 'General'),
            ];
        }
    }
    return $files;
}

function nawa_operator_templates(array $aclFiles): array
{
    $full = array_keys($aclFiles);
    $operations = [];
    $readOnly = [];
    foreach ($aclFiles as $file => $meta) {
        if (in_array($meta['category'], ['Management', 'Accounting', 'Billing', 'Reporting', 'Graphs'], true)) {
            $operations[] = $file;
        }
        $destructive = preg_match('/(?:^|_)(?:del|delete|edit|new|add|import|cleanup|disconnect|create)(?:_|$)/i', $file) === 1;
        $readPage = preg_match('/(?:^acct_|^rep_|^graphs_|_list$|_query$|_date$|_active$|_all$|_username$|_ipaddress$|_nasipaddress$)/i', $file) === 1;
        if ($readPage && !$destructive) {
            $readOnly[] = $file;
        }
    }
    sort($full);
    sort($operations);
    sort($readOnly);
    return ['full' => $full, 'operations' => $operations, 'readonly' => $readOnly];
}

function nawa_operator_selected_permissions(string $role, array $posted, array $aclFiles, array $templates): array
{
    if (isset($templates[$role])) {
        return $templates[$role];
    }
    $selected = [];
    foreach ($posted as $file) {
        $file = (string) $file;
        if (isset($aclFiles[$file])) {
            $selected[] = $file;
        }
    }
    $selected = array_values(array_unique($selected));
    sort($selected);
    return $selected;
}

function nawa_operator_save_acl($dbSocket, string $aclTable, int $operatorId, array $aclFiles, array $selected): bool
{
    $delete = $dbSocket->query(sprintf('DELETE FROM `%s` WHERE operator_id=%d', $aclTable, $operatorId));
    if (DB::isError($delete)) {
        return false;
    }
    $allowed = array_fill_keys($selected, true);
    $rows = [];
    foreach (array_keys($aclFiles) as $file) {
        $rows[] = sprintf(
            "(%d, '%s', %d)",
            $operatorId,
            $dbSocket->escapeSimple($file),
            isset($allowed[$file]) ? 1 : 0
        );
    }
    if ($rows === []) {
        return false;
    }
    $insert = $dbSocket->query(sprintf(
        'INSERT INTO `%s` (operator_id, file, access) VALUES %s',
        $aclTable,
        implode(',', $rows)
    ));
    return !DB::isError($insert);
}

function nawa_operator_role(array $permissions, array $templates): string
{
    sort($permissions);
    foreach ($templates as $role => $template) {
        $candidate = $template;
        sort($candidate);
        if ($permissions === $candidate) {
            return $role;
        }
    }
    return 'custom';
}

$aclFiles = nawa_operator_acl_files($dbSocket, $aclFilesTable);
$templates = nawa_operator_templates($aclFiles);
$currentOperatorId = (int) ($_SESSION['operator_id'] ?? 0);
$currentPermissions = [];
$currentAclResult = $dbSocket->query(sprintf(
    "SELECT file FROM `%s` WHERE operator_id=%d AND access=1",
    $aclTable,
    $currentOperatorId
));
if (!DB::isError($currentAclResult)) {
    while ($row = $currentAclResult->fetchRow()) {
        $currentPermissions[(string) $row[0]] = true;
    }
}
$canCreate = isset($currentPermissions['config_operators_new']);
$canEdit = isset($currentPermissions['config_operators_edit']);
$canDelete = isset($currentPermissions['config_operators_del']);

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    if (!isset($_POST['csrf_token']) || !dalo_check_csrf_token((string) $_POST['csrf_token'])) {
        $failureMsg = 'انتهت صلاحية الجلسة. حدّث الصفحة وحاول مرة أخرى.';
    } else {
        $action = (string) ($_POST['action'] ?? '');
        if ($action === 'save') {
            $id = max(0, (int) ($_POST['id'] ?? 0));
            $creating = $id === 0;
            if (($creating && !$canCreate) || (!$creating && !$canEdit)) {
                $failureMsg = 'ليست لديك صلاحية تنفيذ هذه العملية.';
            } else {
                $username = trim(str_replace('%', '', (string) ($_POST['username'] ?? '')));
                $password = (string) ($_POST['password'] ?? '');
                $passwordConfirm = (string) ($_POST['password_confirm'] ?? '');
                $role = (string) ($_POST['role'] ?? 'custom');
                $postedPermissions = isset($_POST['permissions']) && is_array($_POST['permissions'])
                    ? $_POST['permissions'] : [];
                $selected = nawa_operator_selected_permissions($role, $postedPermissions, $aclFiles, $templates);

                if (preg_match('/\A[\p{L}\p{N}_.@-]{3,64}\z/u', $username) !== 1) {
                    $failureMsg = 'اسم المشرف يجب أن يكون بين 3 و64 حرفًا، بدون مسافات.';
                } elseif (($creating || $password !== '') && (strlen($password) < 8 || strlen($password) > 128)) {
                    $failureMsg = 'كلمة المرور يجب أن تكون بين 8 و128 حرفًا.';
                } elseif (($creating || $password !== '') && $password !== $passwordConfirm) {
                    $failureMsg = 'تأكيد كلمة المرور غير مطابق.';
                } else {
                    $existsSql = sprintf(
                        "SELECT COUNT(*) FROM `%s` WHERE username='%s'%s",
                        $operatorsTable,
                        $dbSocket->escapeSimple($username),
                        $creating ? '' : sprintf(' AND id<>%d', $id)
                    );
                    $exists = (int) $dbSocket->getOne($existsSql) > 0;
                    if ($exists) {
                        $failureMsg = 'اسم المشرف مستخدم مسبقًا.';
                    } else {
                        if (!$creating && $id === $currentOperatorId && !in_array('config_operators_list', $selected, true)) {
                            $selected[] = 'config_operators_list';
                        }
                        $dbSocket->query('START TRANSACTION');
                        if ($creating) {
                            $hash = password_hash($password, PASSWORD_DEFAULT);
                            $result = $dbSocket->query(sprintf(
                                "INSERT INTO `%s` (username, password) VALUES ('%s','%s')",
                                $operatorsTable,
                                $dbSocket->escapeSimple($username),
                                $dbSocket->escapeSimple($hash)
                            ));
                            $id = DB::isError($result) ? 0 : (int) $dbSocket->getOne('SELECT LAST_INSERT_ID()');
                        } else {
                            $passwordSql = $password !== ''
                                ? sprintf(", password='%s'", $dbSocket->escapeSimple(password_hash($password, PASSWORD_DEFAULT)))
                                : '';
                            $result = $dbSocket->query(sprintf(
                                "UPDATE `%s` SET username='%s'%s WHERE id=%d",
                                $operatorsTable,
                                $dbSocket->escapeSimple($username),
                                $passwordSql,
                                $id
                            ));
                        }
                        $saved = $id > 0 && !DB::isError($result)
                              && nawa_operator_save_acl($dbSocket, $aclTable, $id, $aclFiles, $selected);
                        if ($saved) {
                            $dbSocket->query('COMMIT');
                            if ($id === $currentOperatorId) {
                                $_SESSION['operator_user'] = $username;
                                $operator = $username;
                            }
                            $successMsg = $creating ? 'تم إنشاء حساب المشرف بنجاح.' : 'تم تحديث حساب المشرف وصلاحياته.';
                        } else {
                            $dbSocket->query('ROLLBACK');
                            $failureMsg = 'تعذر حفظ حساب المشرف في قاعدة البيانات.';
                        }
                    }
                }
            }
        } elseif ($action === 'delete') {
            $id = max(0, (int) ($_POST['id'] ?? 0));
            if (!$canDelete) {
                $failureMsg = 'ليست لديك صلاحية حذف المشرفين.';
            } elseif ($id <= 0) {
                $failureMsg = 'حساب المشرف المطلوب غير صالح.';
            } elseif ($id === $currentOperatorId) {
                $failureMsg = 'لا يمكنك حذف الحساب الذي تستخدمه الآن.';
            } else {
                $targetManagesOperators = (int) $dbSocket->getOne(sprintf(
                    "SELECT COUNT(*) FROM `%s` WHERE operator_id=%d AND file='config_operators_list' AND access=1",
                    $aclTable,
                    $id
                )) > 0;
                $otherManagers = (int) $dbSocket->getOne(sprintf(
                    "SELECT COUNT(DISTINCT operator_id) FROM `%s` WHERE operator_id<>%d AND file='config_operators_list' AND access=1",
                    $aclTable,
                    $id
                ));
                if ($targetManagesOperators && $otherManagers === 0) {
                    $failureMsg = 'لا يمكن حذف آخر حساب يملك صلاحية إدارة المشرفين.';
                } else {
                    $dbSocket->query('START TRANSACTION');
                    $aclDelete = $dbSocket->query(sprintf('DELETE FROM `%s` WHERE operator_id=%d', $aclTable, $id));
                    $operatorDelete = $dbSocket->query(sprintf('DELETE FROM `%s` WHERE id=%d', $operatorsTable, $id));
                    if (!DB::isError($aclDelete) && !DB::isError($operatorDelete)) {
                        $dbSocket->query('COMMIT');
                        $successMsg = 'تم حذف حساب المشرف.';
                    } else {
                        $dbSocket->query('ROLLBACK');
                        $failureMsg = 'تعذر حذف حساب المشرف.';
                    }
                }
            }
        } else {
            $failureMsg = 'العملية المطلوبة غير معروفة.';
        }
    }

    if ($ajaxMode) {
        nawa_operator_json($failureMsg === '' ? 200 : 422, $failureMsg === '', $failureMsg === '' ? $successMsg : $failureMsg);
    }
}

$operators = [];
$operatorResult = $dbSocket->query(sprintf('SELECT id, username FROM `%s` ORDER BY id', $operatorsTable));
if (!DB::isError($operatorResult)) {
    while ($row = $operatorResult->fetchRow(DB_FETCHMODE_ASSOC)) {
        $id = (int) $row['id'];
        $permissions = [];
        $permissionResult = $dbSocket->query(sprintf(
            "SELECT file FROM `%s` WHERE operator_id=%d AND access=1 ORDER BY file",
            $aclTable,
            $id
        ));
        if (!DB::isError($permissionResult)) {
            while ($permissionRow = $permissionResult->fetchRow()) {
                $permissions[] = (string) $permissionRow[0];
            }
        }
        $operators[] = [
            'id' => $id,
            'username' => (string) $row['username'],
            'permissions' => $permissions,
            'role' => nawa_operator_role($permissions, $templates),
        ];
    }
}

$roleLabels = [
    'full' => 'مدير كامل',
    'operations' => 'مشرف تشغيل',
    'readonly' => 'مشاهدة فقط',
    'custom' => 'صلاحيات مخصصة',
];
$categoryLabels = [
    'Accounting' => 'المحاسبة', 'Billing' => 'الفوترة', 'Configuration' => 'إعدادات النظام',
    'GIS' => 'الخرائط', 'Graphs' => 'الرسوم البيانية', 'Management' => 'الإدارة والتشغيل',
    'Reporting' => 'التقارير',
];
$groupedAcl = [];
foreach ($aclFiles as $file => $meta) {
    $groupedAcl[$meta['category']][$meta['section']][$file] = true;
}
$fullManagers = count(array_filter($operators, static fn(array $item): bool => $item['role'] === 'full'));
$csrf = dalo_csrf_token();

if (!$fragmentMode) {
    print_html_prologue('إدارة المشرفين', $langCode, ['static/css/nawa-production.css']);
}
?>
<style>
