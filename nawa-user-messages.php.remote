<?php
declare(strict_types=1);
date_default_timezone_set('Asia/Aden');
include 'library/checklogin.php';
$operator = (string) $_SESSION['operator_user'];
include_once '../common/includes/config_read.php';
$operator_perm_file = 'mng_list_all';
include 'library/check_operator_perm.php';
include_once 'lang/main.php';
include_once '../common/includes/validation.php';
include '../common/includes/layout.php';
include_once 'include/nawa/functions.php';
include '../common/includes/db_open.php';
$fragmentMode = isset($_GET['fragment']) && $_GET['fragment'] === '1';
$notice = '';
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['csrf_token']) && dalo_check_csrf_token((string) $_POST['csrf_token'])) {
    $id = (int) ($_POST['id'] ?? 0); $status = (string) ($_POST['status'] ?? '');
    if ($id > 0 && in_array($status, ['new','reviewed','resolved'], true)) {
        $result = $dbSocket->query("UPDATE subscriber_feedback SET status=" . $dbSocket->quoteSmart($status) . ", reviewed_at=UTC_TIMESTAMP(6), reviewed_by=" . $dbSocket->quoteSmart($operator) . " WHERE id={$id}");
        $notice = DB::isError($result) ? 'تعذر تحديث الحالة.' : 'تم تحديث حالة الرسالة.';
    }
}
$filter = (string) ($_GET['status'] ?? 'new');
if (!in_array($filter, ['all','new','reviewed','resolved'], true)) $filter = 'new';
$where = $filter === 'all' ? '' : " WHERE status=" . $dbSocket->quoteSmart($filter);
$result = $dbSocket->query("SELECT id,username,phone,network_name,category,message,status,created_at,reviewed_at,reviewed_by FROM subscriber_feedback{$where} ORDER BY created_at DESC,id DESC LIMIT 250");
$rows = []; if (!DB::isError($result)) while ($row = $result->fetchRow(DB_FETCHMODE_ASSOC)) $rows[] = $row;
$counts = []; $countResult = $dbSocket->query("SELECT status,COUNT(*) total FROM subscriber_feedback GROUP BY status");
if (!DB::isError($countResult)) while ($row = $countResult->fetchRow(DB_FETCHMODE_ASSOC)) $counts[$row['status']] = (int) $row['total'];
$csrf = dalo_csrf_token(); if (!$fragmentMode) print_html_prologue('رسائل المستخدمين', $langCode, ['static/css/nawa-production.css']);
?>
<style>.inbox{--ink:#102e5d;--muted:#7085a8;max-width:1360px;margin:auto;padding:26px;direction:rtl;color:var(--ink);background:#f5f9ff}.inbox-card{background:#fff;border:1px solid #dce8f7;border-radius:17px;padding:20px;margin-bottom:16px;box-shadow:0 6px 20px #1b4f8510}.inbox-head{display:flex;justify-content:space-between;align-items:center;gap:12px;min-height:82px;background:linear-gradient(110deg,#fff,#f1f7ff)}.inbox-head h1{margin:0;font-size:31px;color:#102e5d}.inbox-head h1:before{content:'⚠';display:inline-grid;place-items:center;width:64px;height:64px;margin-left:16px;border-radius:16px;background:#ffe3e6;color:#d4142a;font-size:28px;vertical-align:middle}.inbox-head p,.inbox-meta{color:var(--muted)}.inbox-tabs{display:flex;gap:9px;flex-wrap:wrap;padding-bottom:16px;border-bottom:1px solid #e8eff8}.inbox-tabs a{padding:9px 13px;border:1px solid #d9e6f6;border-radius:10px;text-decoration:none;color:#52709d;font-size:13px;background:#fff}.inbox-tabs a.active{background:#e5233f;color:#fff;border-color:#e5233f}.inbox-item{padding:17px 4px;border-bottom:1px solid #e7eef7}.inbox-item:last-child{border:0}.inbox-message{white-space:pre-wrap;line-height:1.8;margin:12px 0;color:#173867}.inbox-actions{display:flex;gap:8px;align-items:center}.inbox-actions button{padding:8px 12px;border:1px solid #bcd8fb;border-radius:9px;background:#f7fbff;color:#1764b0;cursor:pointer;font:inherit}.inbox-actions button:last-child{background:#e9f8f0;border-color:#a5e3c1;color:#078654}.inbox-alert{padding:12px;border-radius:10px;background:#e9f8f0;color:#078654;margin:12px 0}@media(max-width:650px){.inbox{padding:14px}.inbox-head{align-items:start;flex-direction:column}.inbox-head h1{font-size:25px}}</style>
<main class="inbox"><section class="inbox-card inbox-head"><div><h1>مشاكل المستخدمين</h1><p>كل رسالة تتضمن رقم الجوال واسم الشبكة المستخدمة.</p></div><a class="nawa-button" href="nawa-notifications.php" onclick="if(window.loadSection){loadSection('nawa-notifications.php?fragment=1');return false}"><i class="bi bi-send"></i> إرسال رسائل</a></section><?php if ($notice): ?><div class="inbox-alert"><?= nawa_e($notice) ?></div><?php endif; ?><section class="inbox-stats"><div class="inbox-stat all"><i class="bi bi-inbox"></i><div><b><?= array_sum($counts) ?></b><strong>الكل</strong><span>إجمالي البلاغات</span></div></div><div class="inbox-stat resolved"><i class="bi bi-arrow-repeat"></i><div><b><?= $counts['resolved']??0 ?></b><strong>تم الحل</strong><span>مكتملة</span></div></div><div class="inbox-stat reviewed"><i class="bi bi-clock"></i><div><b><?= $counts['reviewed']??0 ?></b><strong>قيد المراجعة</strong><span>تحت المعالجة</span></div></div><div class="inbox-stat new"><i class="bi bi-exclamation-circle"></i><div><b><?= $counts['new']??0 ?></b><strong>مشاكل جديدة</strong><span>تحتاج إلى مراجعة</span></div></div></section><section class="inbox-card inbox-filter"><nav class="inbox-tabs"><?php foreach (['all'=>'الكل','resolved'=>'تم الحل','reviewed'=>'قيد المراجعة','new'=>'جديدة'] as $key=>$label): ?><a class="<?= $filter===$key?'active':'' ?>" href="nawa-user-messages.php?status=<?= $key ?>" onclick="if(window.loadSection){loadSection('nawa-user-messages.php?fragment=1&amp;status=<?= $key ?>');return false}"><?= $label ?> (<?= $key==='all'?array_sum($counts):($counts[$key]??0) ?>)</a><?php endforeach; ?></nav><div class="inbox-search"><i class="bi bi-search"></i><span>بحث في رقم الجوال أو الشبكة أو الملاحظة...</span></div><a class="inbox-reset" href="nawa-user-messages.php?status=new" onclick="if(window.loadSection){loadSection('nawa-user-messages.php?fragment=1&amp;status=new');return false}"><i class="bi bi-arrow-repeat"></i> إعادة تعيين</a></section><section class="inbox-card inbox-list"><header><div><h2><i class="bi bi-list-ul"></i> قائمة المشاكل</h2><p>عرض جميع الرسائل والمشاكل المبلغ عنها من النظام.</p></div></header><div class="inbox-table-head"><span>#</span><span>رقم الجوال</span><span>الشبكة</span><span>اسم المستخدم</span><span>الرسالة</span><span>التاريخ والوقت</span><span>الحالة</span><span>الإجراءات</span></div><?php foreach ($rows as $row): ?><article class="inbox-item"><span class="inbox-num"><?= (int)$row['id'] ?></span><span class="inbox-phone" dir="ltr"><?= nawa_e($row['phone'] ?? '—') ?></span><span><?= nawa_e($row['network_name'] ?? '—') ?></span><span dir="ltr"><?= nawa_e($row['username']) ?></span><div class="inbox-message"><?= nawa_e($row['message']) ?></div><span class="inbox-date"><?= nawa_e($row['created_at']) ?></span><span class="inbox-status <?= nawa_e($row['status']) ?>"><?= $row['status']==='new'?'جديدة':($row['status']==='reviewed'?'قيد المراجعة':'تم الحل') ?></span><form class="inbox-actions" method="post"><input type="hidden" name="csrf_token" value="<?= nawa_e($csrf) ?>"><input type="hidden" name="id" value="<?= (int)$row['id'] ?>"><button name="status" value="reviewed">قيد المراجعة</button><button name="status" value="resolved">تم الحل وإشعار المستخدم</button></form></article><?php endforeach; if (!$rows): ?><p class="inbox-empty">لا توجد رسائل في هذا القسم.</p><?php endif; ?></section><section class="inbox-card inbox-notes"><i class="bi bi-lightbulb"></i><div><h2>ملاحظات مهمة</h2><p>يتم عرض الرسائل الواردة من النظام تلقائيًا. راجع كل مشكلة وتواصل مع المستخدم عند الحاجة، ثم اختر «تم الحل وإشعار المستخدم» لإرسال التأكيد.</p></div></section></main>
<style>body.dark .dashboard-content,html[data-theme="dark"] .dashboard-content{background:#020e1d!important;min-height:calc(100vh - 74px)!important;padding:0!important}body.dark .inbox,html[data-theme="dark"] .inbox{--ink:#e8f1ff;--muted:#aac0df;max-width:none!important;min-height:calc(100vh - 74px);margin:0!important;padding:28px 31px!important;background:radial-gradient(circle at 50% 0,#092a4b 0,#020e1d 47%)!important}body.dark .inbox-card,html[data-theme="dark"] .inbox-card{background:linear-gradient(135deg,#082742,#04172b)!important;border-color:#174974!important;box-shadow:none!important}body.dark .inbox-head,html[data-theme="dark"] .inbox-head{min-height:120px;background:linear-gradient(110deg,#082945,#05182d)!important}body.dark .inbox-head h1,html[data-theme="dark"] .inbox-head h1{color:#eaf2ff!important;font-size:32px!important}body.dark .inbox-head h1:before,html[data-theme="dark"] .inbox-head h1:before{background:linear-gradient(145deg,#5b1430,#2e1024)!important;color:#ff697c!important}body.dark .inbox-head p,body.dark .inbox-meta,html[data-theme="dark"] .inbox-head p,html[data-theme="dark"] .inbox-meta{color:#b3c9e8!important}body.dark .inbox-tabs,html[data-theme="dark"] .inbox-tabs{border-color:#17426c!important}body.dark .inbox-tabs a,html[data-theme="dark"] .inbox-tabs a{border-color:#25568b!important;background:#061d35!important;color:#c2d7f4!important}body.dark .inbox-tabs a.active,html[data-theme="dark"] .inbox-tabs a.active{background:#1264db!important;border-color:#2789ff!important;color:#fff!important}body.dark .inbox-item,html[data-theme="dark"] .inbox-item{border-color:#163c64!important}body.dark .inbox-message,html[data-theme="dark"] .inbox-message{color:#eef5ff!important}body.dark .inbox-actions button,html[data-theme="dark"] .inbox-actions button{border-color:#1c64a0!important;background:#062d57!important;color:#ddecff!important}body.dark .inbox-actions button:last-child,html[data-theme="dark"] .inbox-actions button:last-child{border-color:#079567!important;background:#07513e!important}</style>
<style>
