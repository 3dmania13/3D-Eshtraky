#f0cbd7;background:linear-gradient(110deg,#fff,#fff8fb)}html:not([data-theme="dark"]) body:not(.dark) .inbox-stat.new i{background:#ffe3e6;color:#db102d;border:1px solid #ffb5c0}html:not([data-theme="dark"]) body:not(.dark) .inbox-stat.resolved strong{color:#0875e9}html:not([data-theme="dark"]) body:not(.dark) .inbox-stat.reviewed strong{color:#dc7a00}html:not([data-theme="dark"]) body:not(.dark) .inbox-stat.new strong,html:not([data-theme="dark"]) body:not(.dark) .inbox-stat.new b{color:#d81c39}html:not([data-theme="dark"]) body:not(.dark) .inbox-filter{display:flex;gap:16px;align-items:center;padding:16px 21px!important}html:not([data-theme="dark"]) body:not(.dark) .inbox-tabs{order:3;padding:0!important;border:0!important;white-space:nowrap}html:not([data-theme="dark"]) body:not(.dark) .inbox-tabs a{padding:8px 12px!important}html:not([data-theme="dark"]) body:not(.dark) .inbox-search{height:45px;flex:1;display:flex;align-items:center;gap:10px;padding:0 14px;color:#95a9c4;background:#fff;border:1px solid #d5e3f4;border-radius:10px}html:not([data-theme="dark"]) body:not(.dark) .inbox-search i{font-size:18px;color:#52709d}html:not([data-theme="dark"]) body:not(.dark) .inbox-reset{padding:10px 14px;white-space:nowrap;border:1px solid #ffb7bd;border-radius:10px;color:#d4142a;background:#fff7f8;text-decoration:none;font-weight:700}html:not([data-theme="dark"]) body:not(.dark) .inbox-list{padding:0!important;overflow:hidden}html:not([data-theme="dark"]) body:not(.dark) .inbox-list header{display:flex;padding:20px 22px 12px}html:not([data-theme="dark"]) body:not(.dark) .inbox-list h2{margin:0;color:#102e5d;font-size:21px}html:not([data-theme="dark"]) body:not(.dark) .inbox-list h2 i{color:#1872dc;margin-left:9px}html:not([data-theme="dark"]) body:not(.dark) .inbox-list header p{margin:5px 0 0;color:#7890ae;font-size:13px}html:not([data-theme="dark"]) body:not(.dark) .inbox-table-head,html:not([data-theme="dark"]) body:not(.dark) .inbox-item{display:grid;grid-template-columns:40px 1fr 1fr 1.1fr 1.8fr 1.35fr .95fr 2.2fr;gap:10px;align-items:center;text-align:center}html:not([data-theme="dark"]) body:not(.dark) .inbox-table-head{padding:13px 20px;background:#f4f9ff;color:#56749f;font-size:13px;font-weight:700}html:not([data-theme="dark"]) body:not(.dark) .inbox-item{padding:12px 20px!important;margin:0!important;border-bottom:1px solid #e7eef7!important;font-size:13px}html:not([data-theme="dark"]) body:not(.dark) .inbox-item:last-of-type{border-bottom:0!important}html:not([data-theme="dark"]) body:not(.dark) .inbox-item>span{color:#264978}html:not([data-theme="dark"]) body:not(.dark) .inbox-message{margin:0!important;line-height:1.5!important;text-align:right}html:not([data-theme="dark"]) body:not(.dark) .inbox-date{font-size:12px;color:#58759f!important}html:not([data-theme="dark"]) body:not(.dark) .inbox-status{display:inline-block!important;padding:6px 10px;border-radius:8px;white-space:nowrap;font-weight:700}html:not([data-theme="dark"]) body:not(.dark) .inbox-status.new{background:#fff0f2;color:#d4142a}html:not([data-theme="dark"]) body:not(.dark) .inbox-status.reviewed{background:#fff7e9;color:#d58300}html:not([data-theme="dark"]) body:not(.dark) .inbox-status.resolved{background:#e9f8f0;color:#078654}html:not([data-theme="dark"]) body:not(.dark) .inbox-actions{justify-content:center;flex-wrap:wrap}html:not([data-theme="dark"]) body:not(.dark) .inbox-actions button{font-size:12px!important;padding:7px 9px!important}html:not([data-theme="dark"]) body:not(.dark) .inbox-empty{padding:30px;text-align:center;color:#7085a8}html:not([data-theme="dark"]) body:not(.dark) .inbox-notes{display:flex;align-items:flex-start;gap:18px;padding:20px 24px!important;background:#f1f8ff!important}html:not([data-theme="dark"]) body:not(.dark) .inbox-notes>i{display:grid;place-items:center;width:64px;height:64px;flex:none;border-radius:16px;background:#dceeff;color:#086ce9;font-size:31px}html:not([data-theme="dark"]) body:not(.dark) .inbox-notes h2{margin:0;font-size:18px}html:not([data-theme="dark"]) body:not(.dark) .inbox-notes p{margin:8px 0 0;color:#54719a;line-height:1.8}@media(max-width:1050px){html:not([data-theme="dark"]) body:not(.dark) .inbox-stats{grid-template-columns:repeat(2,1fr)}html:not([data-theme="dark"]) body:not(.dark) .inbox-table-head{display:none}html:not([data-theme="dark"]) body:not(.dark) .inbox-item{grid-template-columns:repeat(2,1fr);text-align:right}html:not([data-theme="dark"]) body:not(.dark) .inbox-actions{justify-content:flex-start}}@media(max-width:650px){html:not([data-theme="dark"]) body:not(.dark) .inbox-stats{grid-template-columns:1fr}html:not([data-theme="dark"]) body:not(.dark) .inbox-filter{flex-wrap:wrap}html:not([data-theme="dark"]) body:not(.dark) .inbox-tabs{order:0}html:not([data-theme="dark"]) body:not(.dark) .inbox-item{grid-template-columns:1fr}html:not([data-theme="dark"]) body:not(.dark) .inbox-head{padding:18px!important}}
</style>
<script>
(function(){
  document.querySelectorAll('.inbox-actions').forEach(function(form){
    form.addEventListener('submit',async function(event){
      event.preventDefault();
      const button=event.submitter;
      const original=button?button.textContent:'';
      if(button){button.disabled=true;button.textContent='جاري التحديث...';}
      try{
        const data=new FormData(form);
        if(button&&button.name)data.append(button.name,button.value);
        const response=await fetch('nawa-user-messages.php?fragment=1&status=<?= rawurlencode($filter) ?>',{method:'POST',body:data,credentials:'same-origin',cache:'no-store'});
        if(!response.ok)throw new Error('HTTP '+response.status);
        if(window.nawaFragmentCache)window.nawaFragmentCache.clear();
        if(window.loadSection){
          window.loadSection('nawa-user-messages.php?fragment=1&status=<?= rawurlencode($filter) ?>&refresh='+Date.now());
        }else{
          window.location.href='nawa-user-messages.php?status=<?= rawurlencode($filter) ?>';
        }
      }catch(error){
        if(button){button.disabled=false;button.textContent=original;}
        window.alert('تعذر تحديث حالة المشكلة. حاول مرة أخرى.');
      }
    });
  });
})();
</script>
<style>
