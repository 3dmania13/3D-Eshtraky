:is(body.dark,body[data-theme="dark"],html[data-theme="dark"] body) .inbox-stat div{display:grid;text-align:left}
:is(body.dark,body[data-theme="dark"],html[data-theme="dark"] body) .inbox-stat b{font-size:31px;line-height:1.08;color:#eaf2ff}
:is(body.dark,body[data-theme="dark"],html[data-theme="dark"] body) .inbox-stat strong{font-size:16px;color:#c8dcf7}
:is(body.dark,body[data-theme="dark"],html[data-theme="dark"] body) .inbox-stat span{margin-top:5px;font-size:13px;color:#9fb8da}
:is(body.dark,body[data-theme="dark"],html[data-theme="dark"] body) .inbox-stat.all i{background:#142d4e;border:1px solid #315b8d;color:#9ac6ff}
:is(body.dark,body[data-theme="dark"],html[data-theme="dark"] body) .inbox-stat.resolved i{background:#06366d;border:1px solid #087df0;color:#3196ff}
:is(body.dark,body[data-theme="dark"],html[data-theme="dark"] body) .inbox-stat.resolved strong{color:#2994ff}
:is(body.dark,body[data-theme="dark"],html[data-theme="dark"] body) .inbox-stat.reviewed i{background:#4c2a0a;border:1px solid #b86704;color:#ff970f}
