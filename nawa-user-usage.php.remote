<?php
@ini_set('pcre.jit', '0');
date_default_timezone_set('Asia/Aden');
include('library/checklogin.php');
include_once('../common/includes/config_read.php');
include('../common/includes/db_open.php');
require_once('user-usage-data.php');
require_once('nawa-usage-sessions.php');

$username = trim((string) ($_GET['username'] ?? ''));
$report = $username !== ''
    ? nawa_usage_report($dbSocket, $username, (string) ($_GET['from'] ?? ''), (string) ($_GET['to'] ?? ''))
    : null;
$selectedDay = nawa_usage_valid_date($_GET['day'] ?? '');
$selectedDay = $selectedDay ? $selectedDay->format('Y-m-d') : null;
$sessionDetails = null;
$sessionError = false;
if ($report !== null) {
    if ($selectedDay !== null && ($selectedDay < $report['from'] || $selectedDay > $report['to'])) $selectedDay = null;
    try {
        $sessionCounts = nawa_usage_session_counts($dbSocket, $username, $report['from'], $report['to']);
        foreach ($report['days'] as &$usageDay) $usageDay['session_count'] = $sessionCounts['days'][$usageDay['date']] ?? 0;
        unset($usageDay);
        $report['sessions'] = $sessionCounts['unique'];
        if ($selectedDay !== null) $sessionDetails = nawa_usage_day_sessions($dbSocket, $username, $selectedDay, (int) ($_GET['session_page'] ?? 1));
    } catch (Throwable $error) {
        $sessionError = true;
        error_log('Usage session details: ' . $error->getMessage());
    }
}
include('../common/includes/db_close.php');

if ($report === null):
?>
<div class="nawa-page"><section class="nawa-page-header"><div><h1>تفاصيل الاستخدام</h1><p>تعذر العثور على المشترك المطلوب.</p></div><button class="nawa-button" type="button" onclick="loadSection('nawa-users.php?fragment=1')"><i class="bi bi-arrow-right"></i> رجوع للمشتركين</button></section><div class="nawa-empty"><i class="bi bi-person-x"></i>الحساب غير موجود أو ليس من حسابات المشتركين.</div></div>
<?php return; endif;

$subscriber = $report['subscriber'];
$isCard = ($subscriber['account_type'] ?? '') === 'card';
$cardSearch = $isCard ? trim((string) ($_GET['card_search'] ?? '')) : '';
$cardPage = $isCard ? max(1, (int) ($_GET['card_page'] ?? 1)) : 1;
$returnUrl = $isCard
    ? 'nawa-card-recharge.php?fragment=1&card=' . rawurlencode($cardSearch) . '&page=' . $cardPage
    : 'nawa-users.php?fragment=1';
$usageContext = $isCard
    ? '&source=card&card_search=' . rawurlencode($cardSearch) . '&card_page=' . $cardPage
    : '';
$fullname = trim((string) ($subscriber['fullname'] ?? '')) ?: ($isCard ? 'كرت شحن' : 'بدون اسم مسجل');
$quota = (float) ($subscriber['quota_bytes'] ?? 0);
$used = (float) ($subscriber['used_bytes'] ?? 0);
$remaining = $quota > 0 ? max(0, $quota - $used) : null;
$maxDaily = max(1, (float) max(array_column($report['days'], 'total_bytes')));
$pdfUrl = 'nawa-user-usage-pdf.php?' . http_build_query(['username' => $username, 'from' => $report['from'], 'to' => $report['to']]);
$daysReversed = array_reverse($report['days']);
$usageBaseUrl = 'nawa-user-usage.php?' . http_build_query(['fragment' => 1, 'username' => $username, 'from' => $report['from'], 'to' => $report['to']]) . $usageContext;
$selectedSummary = null;
foreach ($report['days'] as $usageDay) if ($usageDay['date'] === $selectedDay) $selectedSummary = $usageDay;
$chartDayCount = max(1, count($report['days']));
$chartWidth = max(720, $chartDayCount * 96);
$chartHeight = 290;
$chartPaddingX = 42;
$chartPaddingTop = 24;
$chartPaddingBottom = 42;
$chartPlotHeight = $chartHeight - $chartPaddingTop - $chartPaddingBottom;
$chartStep = $chartDayCount > 1 ? ($chartWidth - ($chartPaddingX * 2)) / ($chartDayCount - 1) : 0;
$chartMax = max(1, (float) max(array_column($report['days'], 'total_bytes')));
$downloadPoints = [];
$uploadPoints = [];
$chartDots = [];
foreach ($report['days'] as $chartIndex => $chartDay) {
    $chartX = $chartDayCount > 1 ? $chartPaddingX + ($chartIndex * $chartStep) : $chartWidth / 2;
    $downloadY = $chartPaddingTop + $chartPlotHeight - (($chartDay['download_bytes'] / $chartMax) * $chartPlotHeight);
    $uploadY = $chartPaddingTop + $chartPlotHeight - (($chartDay['upload_bytes'] / $chartMax) * $chartPlotHeight);
    $downloadPoints[] = number_format($chartX, 2, '.', '') . ',' . number_format($downloadY, 2, '.', '');
    $uploadPoints[] = number_format($chartX, 2, '.', '') . ',' . number_format($uploadY, 2, '.', '');
    $chartDots[] = ['x' => $chartX, 'download_y' => $downloadY, 'upload_y' => $uploadY, 'day' => $chartDay];
}
$downloadAreaPoints = $chartPaddingX . ',' . ($chartHeight - $chartPaddingBottom) . ' ' . implode(' ', $downloadPoints) . ' ' . ($chartWidth - $chartPaddingX) . ',' . ($chartHeight - $chartPaddingBottom);
?>
<style>
.usage-page{display:grid;gap:16px}.usage-identity{display:flex;align-items:center;gap:12px}.usage-avatar{display:grid;place-items:center;width:46px;height:46px;border-radius:14px;background:#fff0ef;color:#e5221a;font-size:18px;font-weight:900}.usage-identity b{display:block;font-size:14px}.usage-identity small{display:block;margin-top:4px;color:#858d9e;font-size:10px}.usage-period{display:flex;align-items:end;gap:9px;padding:13px 15px;border:1px solid #e4e7ec;border-radius:14px;background:#fff}.usage-period label{display:grid;gap:5px;color:#737c8d;font-size:9px;font-weight:800}.usage-period input{border:1px solid #dfe3e9;border-radius:9px;padding:9px 10px;color:#25272c;font-size:10px}.usage-presets{display:flex;gap:6px}.usage-presets button{border:1px solid #e0e3e9;border-radius:8px;background:#f8f9fb;padding:9px 10px;color:#5e6675;font-size:9px;font-weight:800;cursor:pointer}.usage-presets button:hover{border-color:#e5221a;color:#e5221a}.usage-summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.usage-metric,.usage-card{background:#fff;border:1px solid #e5e8ed;border-radius:17px;box-shadow:0 8px 27px rgba(25,26,29,.04)}.usage-metric{padding:17px}.usage-metric span{display:flex;align-items:center;justify-content:space-between;color:#858d9d;font-size:10px}.usage-metric i{display:grid;place-items:center;width:32px;height:32px;border-radius:10px;background:#fff0ef;color:#e5221a;font-size:15px}.usage-metric strong{display:block;margin-top:8px;font-size:20px}.usage-metric small{color:#8f96a4;font-size:9px}.usage-card{overflow:hidden}.usage-card-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:17px 19px;border-bottom:1px solid #eceef2}.usage-card-head h2{margin:0;font-size:14px}.usage-card-head p{margin:4px 0 0;color:#8a92a2;font-size:10px}.usage-legend{display:flex;gap:12px;color:#70798a;font-size:9px}.usage-legend span{display:flex;align-items:center;gap:5px}.usage-legend i{width:8px;height:8px;border-radius:3px;background:#e5221a}.usage-legend span:last-child i{background:#25272c}.usage-chart-scroll{overflow:auto;padding:22px 18px 12px}.usage-chart{display:grid;align-items:end;gap:7px;height:270px;min-width:720px;border-bottom:1px solid #e7e9ed;background:repeating-linear-gradient(to top,#f1f3f6 0,#f1f3f6 1px,transparent 1px,transparent 54px)}.usage-bar{display:grid;grid-template-rows:1fr auto;align-items:end;height:100%;min-width:20px}.usage-bar-track{display:flex;align-items:flex-end;justify-content:center;height:230px}.usage-bar-fill{display:flex;flex-direction:column;justify-content:flex-end;width:min(28px,72%);min-height:2px;border-radius:7px 7px 2px 2px;overflow:hidden;background:#eceef2;transition:.2s}.usage-bar:hover .usage-bar-fill{filter:brightness(.94);transform:translateY(-2px)}.usage-bar-download{display:block;background:linear-gradient(180deg,#ef4139,#e5221a)}.usage-bar-upload{display:block;background:#25272c}.usage-bar label{padding-top:7px;color:#8a92a1;font-size:8px;text-align:center;white-space:nowrap}.usage-quota{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:18px;padding:17px 19px}.usage-quota-copy{display:grid;gap:9px}.usage-quota-copy div{display:flex;justify-content:space-between;gap:12px;font-size:10px}.usage-quota-copy span{color:#7f8797}.usage-quota-track{height:8px;border-radius:10px;background:#eceef2;overflow:hidden}.usage-quota-track i{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,#25272c,#e5221a)}.usage-quota-number{text-align:center}.usage-quota-number strong{display:block;font-size:24px}.usage-quota-number small{color:#8991a0;font-size:9px}.usage-table-wrap{max-height:480px;overflow:auto}.usage-table{width:100%;border-collapse:collapse}.usage-table th,.usage-table td{padding:12px 15px;border-bottom:1px solid #eef0f3;text-align:right;font-size:10px;white-space:nowrap}.usage-table th{position:sticky;top:0;background:#fafbfc;color:#858d9d;font-size:9px;z-index:1}.usage-table .total{color:#d8231b;font-weight:900}.usage-zero{color:#a2a8b3}.usage-note{display:flex;align-items:flex-start;gap:9px;padding:12px 14px;border:1px solid #f0dfc5;border-radius:12px;background:#fff9ef;color:#86611e;font-size:9px;line-height:1.7}.usage-note i{font-size:15px}
@media(max-width:950px){.usage-summary{grid-template-columns:repeat(2,minmax(0,1fr))}.usage-period{align-items:stretch;flex-wrap:wrap}}@media(max-width:620px){.usage-summary{grid-template-columns:1fr}.usage-period{display:grid}.usage-presets{overflow:auto}.usage-quota{grid-template-columns:1fr}.usage-quota-number{text-align:right}.usage-card-head{align-items:flex-start;flex-direction:column}}
.usage-day-link{display:inline-flex;align-items:center;gap:9px;color:#c5231c;font-weight:800;text-decoration:none}.usage-day-link:hover{text-decoration:underline}.usage-day-link:focus-visible,.usage-bar:focus-visible{outline:2px solid #e5221a;outline-offset:-2px}.usage-bar{text-decoration:none;cursor:pointer}.usage-bar label{cursor:pointer}.usage-chart-scroll{padding:24px 20px 14px;background:linear-gradient(180deg,#fafbfc 0%,#fff 100%)}.usage-chart{position:relative;height:300px;gap:10px;min-width:760px;border:1px solid #edf0f3;border-radius:14px;background:repeating-linear-gradient(to top,transparent 0,transparent 59px,#e7ebf0 60px),linear-gradient(180deg,#fff 0%,#fbfcfd 100%);box-shadow:inset 0 1px 0 #fff}.usage-bar{position:relative;min-width:24px;padding:0 2px}.usage-bar-track{height:250px}.usage-bar-fill{width:min(34px,78%);min-height:3px;border-radius:9px 9px 3px 3px;box-shadow:0 5px 12px rgba(37,39,44,.12);transition:height .25s ease,transform .2s ease,filter .2s ease}.usage-bar-download{background:linear-gradient(180deg,#ff5a52 0%,#e5221a 100%)}.usage-bar-upload{background:linear-gradient(180deg,#566171 0%,#25272c 100%)}.usage-bar:hover .usage-bar-fill{filter:brightness(1.04);transform:translateY(-4px);box-shadow:0 9px 18px rgba(37,39,44,.2)}.usage-bar label{padding-top:10px;color:#667184;font-size:9px;font-weight:700}.usage-legend{gap:16px}.usage-legend i{width:10px;height:10px;border-radius:3px;box-shadow:0 1px 3px rgba(25,26,29,.16)}.usage-day-link small{color:#7c8492;font-weight:400}.usage-session-status{display:inline-block;padding:4px 8px;border-radius:6px;background:#f1f3f6;color:#647084}.usage-session-status.open{background:#e9f8ef;color:#19764a}.usage-session-time{display:block;direction:ltr;text-align:right;font-variant-numeric:tabular-nums}.usage-session-sub{display:block;margin-top:5px;font-size:9px;color:#828b99}.usage-session-pager{display:flex;align-items:center;justify-content:center;gap:14px;padding:16px}.usage-session-empty{text-align:center!important;padding:30px!important;color:#7f8797}.usage-session-summary{grid-template-columns:repeat(4,minmax(0,1fr))}

/* Usage report: calm blue / teal palette */
.usage-page{color:#23344d;gap:20px;background:#f3f6fb;padding:18px;border-radius:20px}
.usage-page .usage-card,.usage-page .usage-metric,.usage-page .usage-period{border-color:#dfe7f1;box-shadow:0 4px 18px rgba(35,52,77,.035);border-radius:16px;background:#fff}
.usage-page .usage-avatar,.usage-page .usage-metric i{background:#eaf1ff;color:#3569d4}
.usage-page .usage-metric:nth-child(3) i{background:#e5f6f2;color:#168b7a}
.usage-page .usage-metric{padding:20px}
.usage-page .usage-metric strong{font-size:24px;color:#23344d;font-variant-numeric:tabular-nums}
.usage-page .usage-metric span,.usage-page .usage-identity small,.usage-page .usage-card-head p,.usage-page .usage-metric small{color:#64748b}
.usage-page .usage-card-head{padding:20px 22px;border-color:#e9eef5}
.usage-page .usage-card-head h2{color:#23344d;font-size:15px}
.usage-page .nawa-button.primary{background:#3569d4;border-color:#3569d4;color:#fff;box-shadow:none}
.usage-page .nawa-button.primary:hover{background:#2857b7}
.usage-page .usage-presets button:hover{background:#edf3ff;border-color:#9ab6ef;color:#2857b7}
.usage-page input:focus-visible,.usage-page button:focus-visible,.usage-page a:focus-visible{outline:3px solid #92b7ff;outline-offset:3px}
.usage-page .usage-legend{font-size:11px;color:#52647c;gap:18px}
.usage-page .usage-legend i{background:#527fe0;border-radius:50%;box-shadow:none}
.usage-page .usage-legend span:last-child i{background:#28a994}
.usage-page .usage-chart-scroll{padding:22px 24px 18px;background:#fff}
.usage-page .usage-chart{height:260px;gap:12px;border:0;border-radius:0;box-shadow:none;background:repeating-linear-gradient(to top,transparent 0,transparent 51px,#eaf0f7 51px,#eaf0f7 52px);padding:0 8px}
.usage-page .usage-bar{padding:0 4px;grid-template-rows:1fr 42px}
.usage-page .usage-bar-track{height:210px;position:relative;padding-top:26px;box-sizing:border-box}
.usage-page .usage-bar-fill{position:relative;width:min(48px,70%);border-radius:8px 8px 0 0;overflow:visible;min-height:0;background:none;box-shadow:none;transition:filter .18s}
.usage-page .usage-bar-download{background:#527fe0;border-radius:8px 8px 0 0}
.usage-page .usage-bar-upload{background:#28a994}
.usage-page .usage-bar:hover .usage-bar-fill,.usage-page .usage-bar:focus-visible .usage-bar-fill{transform:none;filter:brightness(.94);box-shadow:none}
.usage-page .usage-bar:hover{background:#f4f7fd;border-radius:10px}
.usage-page .usage-bar-value{position:absolute;bottom:100%;left:50%;transform:translateX(-50%);padding-bottom:9px;white-space:nowrap;font-size:10px;font-weight:700;line-height:16px;color:#425773;direction:ltr;font-variant-numeric:tabular-nums}
.usage-page .usage-bar label{font-size:10px;color:#64748b;padding-top:10px;font-weight:500;line-height:16px}
.usage-page .usage-quota-track{background:#e9eff8;height:9px}
.usage-page .usage-quota-track i{background:#527fe0}
.usage-page .usage-quota-number strong{color:#3569d4}
.usage-page .usage-table th{background:#f4f7fc;color:#52647c;font-size:10px}
.usage-page .usage-table td{font-size:11px;padding:15px;border-color:#edf1f6;color:#425773}
.usage-page .usage-table tbody tr:hover{background:#f6f9ff}
.usage-page .usage-table .total,.usage-page .usage-day-link{color:#3569d4}
.usage-page .usage-zero{color:#7b899c}
.usage-page .usage-note{background:#eef4fc;border-color:#dce7f7;color:#526780;font-size:10px}
@media(max-width:620px){.usage-page{padding:10px;gap:12px}.usage-page .usage-summary{grid-template-columns:repeat(2,minmax(0,1fr))}.usage-page .usage-metric{padding:13px}.usage-page .usage-metric strong{font-size:19px}.usage-page .usage-chart-scroll{padding:16px 10px}.usage-page .usage-day-link{flex-wrap:wrap}.usage-page .usage-card-head{padding:16px}}
@media(prefers-reduced-motion:reduce){.usage-page .usage-bar-fill{transition:none}}


/* Trading-style usage chart */
.usage-page .usage-trading-scroll{overflow-x:auto;padding:20px 22px 10px;background:linear-gradient(180deg,#fbfdff,#fff)}
.usage-page .usage-trading-chart{display:block;width:100%;min-width:720px;height:290px;font-family:inherit}
.usage-page .trading-grid line{stroke:#e6edf6;stroke-width:1}
.usage-page .trading-area{fill:url(#usageDownloadArea)}
.usage-page .trading-line{fill:none;stroke-linecap:round;stroke-linejoin:round;stroke-width:3}
.usage-page .download-line{stroke:#527fe0}.usage-page .upload-line{stroke:#28a994;stroke-width:2.5}
.usage-page .trading-dot{stroke:#fff;stroke-width:2}.usage-page .download-dot{fill:#527fe0}.usage-page .upload-dot{fill:#28a994}
.usage-page .trading-hit{fill:transparent;cursor:pointer}.usage-page .trading-point:hover .download-dot,.usage-page .trading-point:focus .download-dot{r:6}.usage-page .trading-point:hover .upload-dot,.usage-page .trading-point:focus .upload-dot{r:5.5}
.usage-page .trading-date{fill:#718096;font-size:10px;text-anchor:middle;font-weight:600}
.usage-page .trading-legend span:first-child i{background:#527fe0}.usage-page .trading-legend span:last-child i{background:#28a994}
@media(max-width:620px){.usage-page .usage-trading-scroll{padding:16px 8px 8px}.usage-page .usage-trading-chart{height:250px}}

/* Usage dashboard finishing layer */
