age .usage-card,body.dark .usage-page .usage-metric,body.dark .usage-page .usage-period{border-color:#1d4264;background:#0b2137;color:#e7f1ff;box-shadow:0 7px 22px #0003}html[data-theme="dark"] .usage-page>.nawa-page-header.usage-hero,body.dark .usage-page>.nawa-page-header.usage-hero{border-color:#1c507f;background:radial-gradient(circle at 42% 50%,#105598 0,transparent 28%),linear-gradient(120deg,#082544,#06162b 58%,#0a284a)}html[data-theme="dark"] .usage-page>.nawa-page-header.usage-hero .usage-identity b,body.dark .usage-page>.nawa-page-header.usage-hero .usage-identity b{color:#eef6ff}html[data-theme="dark"] .usage-page>.nawa-page-header.usage-hero .usage-identity small,body.dark .usage-page>.nawa-page-header.usage-hero .usage-identity small{color:#a9c9ee}html[data-theme="dark"] .usage-page .usage-metric strong,html[data-theme="dark"] .usage-page .usage-card-head h2,body.dark .usage-page .usage-metric strong,body.dark .usage-page .usage-card-head h2{color:#edf6ff}html[data-theme="dark"] .usage-page .usage-card-head,body.dark .usage-page .usage-card-head{border-color:#1d4264;background:#0d2945}html[data-theme="dark"] .usage-page .usage-trading-scroll,body.dark .usage-page .usage-trading-scroll{background:#0b2137}html[data-theme="dark"] .usage-page .trading-grid line,body.dark .usage-page .trading-grid line{stroke:#21435f}html[data-theme="dark"] .usage-page .trading-date,body.dark .usage-page .trading-date{fill:#a8c3df}html[data-theme="dark"] .usage-page .usage-table th,body.dark .usage-page .usage-table th{background:#102d4b;color:#afc8e5}html[data-theme="dark"] .usage-page .usage-table td,body.dark .usage-page .usage-table td{border-color:#1b3d5c;color:#d5e5f6}@media(max-width:760px){.usage-page>.nawa-page-header.usage-hero{align-items:flex-start;padding:17px;gap:15px}.usage-page>.usage-period label:first-of-type{margin-inline-start:0}.usage-page>.usage-period{display:grid;grid-template-columns:1fr 1fr}.usage-page>.usage-period .nawa-button{width:100%}.usage-page>.usage-period .usage-presets{grid-column:1/-1}.usage-page .usage-period input{min-width:0;width:100%;box-sizing:border-box}}@media(max-width:430px){.usage-page>.usage-period{grid-template-columns:1fr}.usage-page>.usage-period .usage-presets{grid-column:auto}.usage-page>.nawa-page-header.usage-hero .nawa-page-actions{width:100%}.usage-page>.nawa-page-header.usage-hero .nawa-page-actions>*{flex:1;text-align:center}.usage-page .usage-summary{grid-template-columns:1fr}}
 .usage-page>.nawa-page-header{position:relative;overflow:hidden;align-items:center;min-height:96px;padding:20px 24px;border:1px solid #dbe8f8;border-radius:17px;background:radial-gradient(circle at 42% 50%,#d8ecff 0,transparent 28%),linear-gradient(120deg,#f8fcff,#eaf4ff 58%,#f9fcff)}.usage-page>.nawa-page-header:before{content:"";position:absolute;inset:-40% auto auto 35%;width:340px;height:180px;border-radius:50%;border:1px solid #bddcff;transform:rotate(-12deg)}.usage-page>.nawa-page-header>*{position:relative}.usage-page>.nawa-page-header .usage-avatar{width:52px;height:52px;border-radius:50%;background:linear-gradient(135deg,#63a7ff,#1263df);color:#fff;box-shadow:0 7px 16px #2072d536}.usage-page>.nawa-page-header .usage-identity b{font-size:18px;color:#102e64}.usage-page>.nawa-page-header .usage-identity small{font-size:11px;color:#466899}.usage-page>.nawa-page-header .nawa-page-actions{display:flex;gap:8px;flex-wrap:wrap}html[data-theme="dark"] .usage-page>.nawa-page-header,body.dark .usage-page>.nawa-page-header{border-color:#1c507f;background:radial-gradient(circle at 42% 50%,#105598 0,transparent 28%),linear-gradient(120deg,#082544,#06162b 58%,#0a284a)}html[data-theme="dark"] .usage-page>.nawa-page-header .usage-identity b,body.dark .usage-page>.nawa-page-header .usage-identity b{color:#eef6ff}html[data-theme="dark"] .usage-page>.nawa-page-header .usage-identity small,body.dark .usage-page>.nawa-page-header .usage-identity small{color:#a9c9ee}
</style>
<div class="nawa-page usage-page">
  <section class="nawa-page-header"><div class="usage-identity"><span class="usage-avatar"><?= nawa_usage_e(mb_substr($isCard ? $username : ($fullname !== 'بدون اسم مسجل' ? $fullname : $username), 0, 1)) ?></span><span><b>تفاصيل استخدام <?= $isCard ? 'الكرت ' : '' ?><?= nawa_usage_e($username) ?></b><small><?= nawa_usage_e($fullname) ?> · <?= nawa_usage_e($subscriber['package_name'] ?? 'بدون باقة') ?><?= !empty($subscriber['mobilephone']) ? ' · ' . nawa_usage_e($subscriber['mobilephone']) : '' ?></small></span></div><div class="nawa-page-actions"><button class="nawa-button" type="button" onclick="loadSection('<?= nawa_usage_e($returnUrl) ?>')"><i class="bi bi-arrow-right"></i> رجوع</button><a class="nawa-button primary" href="<?= nawa_usage_e($pdfUrl) ?>" target="_blank" rel="noopener"><i class="bi bi-file-earmark-pdf"></i> تحميل تقرير PDF</a></div></section>

  <form class="usage-period" id="usage-period-form"><input type="hidden" name="username" value="<?= nawa_usage_e($username) ?>"><label><span>من تاريخ</span><input type="date" name="from" value="<?= nawa_usage_e($report['from']) ?>" max="<?= date('Y-m-d') ?>"></label><label><span>إلى تاريخ</span><input type="date" name="to" value="<?= nawa_usage_e($report['to']) ?>" max="<?= date('Y-m-d') ?>"></label><button class="nawa-button primary" type="submit"><i class="bi bi-funnel"></i> عرض الفترة</button><div class="usage-presets"><button type="button" data-usage-days="7">7 أيام</button><button type="button" data-usage-days="30">30 يوم</button><button type="button" data-usage-days="90">90 يوم</button><?php if ($report['cycle']): ?><button type="button" data-usage-cycle="<?= nawa_usage_e($report['cycle']) ?>">الدورة الحالية</button><?php endif; ?></div></form>

  <?php if ($selectedDay !== null): ?>
  <section class="usage-card"><header class="usage-card-head"><div><h2>تفاصيل يوم <?= nawa_usage_e(nawa_usage_weekday($selectedDay)) ?> · <bdi><?= nawa_usage_e($selectedDay) ?></bdi></h2><p>الجلسات المسجلة خلال هذا اليوم · جميع الأوقات بتوقيت اليمن</p></div><a class="nawa-button" data-usage-link href="<?= nawa_usage_e($usageBaseUrl) ?>"><i class="bi bi-arrow-right"></i> رجوع لتفاصيل الأيام</a></header></section>
  <section class="usage-summary">
    <article class="usage-metric"><span>عدد جلسات اليوم <i class="bi bi-clock-history"></i></span><strong><?= $sessionDetails !== null ? number_format($sessionDetails['count']) : '—' ?></strong><small>يشمل الجلسات الممتدة من اليوم السابق</small></article>
    <article class="usage-metric"><span>تنزيل اليوم <i class="bi bi-arrow-down"></i></span><strong><?= nawa_usage_e(nawa_usage_human($selectedSummary['download_bytes'])) ?></strong><small>حسب تقرير الاستخدام اليومي</small></article>
    <article class="usage-metric"><span>رفع اليوم <i class="bi bi-arrow-up"></i></span><strong><?= nawa_usage_e(nawa_usage_human($selectedSummary['upload_bytes'])) ?></strong><small>حسب تقرير الاستخدام اليومي</small></article>
    <article class="usage-metric"><span>إجمالي استهلاك اليوم <i class="bi bi-bar-chart-line"></i></span><strong><?= nawa_usage_e(nawa_usage_human($selectedSummary['total_bytes'])) ?></strong><small>التنزيل + الرفع</small></article>
  </section>
  <div class="usage-note"><i class="bi bi-info-circle"></i><span>القيم أدناه هي استهلاك كل جلسة كاملة حتى آخر تحديث. الجلسة الممتدة لأكثر من يوم تظهر في كل يوم كانت فيه مسجلة؛ لذلك قد يختلف مجموع استهلاك الجلسات عن إجمالي اليوم، خصوصًا عند تجديد الباقة. السجلات الحالية لا تفصل استهلاك الجلسة الواحدة عند منتصف الليل.</span></div>
  <section class="usage-card"><header class="usage-card-head"><div><h2>جلسات اليوم</h2><p>من الأحدث إلى الأقدم · التنزيل والرفع وإجمالي الاستهلاك لكل جلسة</p></div></header><div class="usage-table-wrap"><table class="usage-table"><thead><tr><th>الجلسة</th><th>من الساعة</th><th>إلى الساعة</th><th>الحالة</th><th>التنزيل</th><th>الرفع</th><th>إجمالي استهلاك الجلسة</th></tr></thead><tbody>
  <?php if ($sessionError): ?><tr><td colspan="7" class="usage-session-empty">تعذر تحميل الجلسات الآن. أعد فتح اليوم للمحاولة مجددًا.</td></tr>
  <?php elseif (empty($sessionDetails['rows'])): ?><tr><td colspan="7" class="usage-session-empty">لا توجد جلسات مسجلة لهذا اليوم.</td></tr>
  <?php else: foreach ($sessionDetails['rows'] as $index => $session): $isOpen = empty($session['acctstoptime']); ?>
    <tr><td><?= number_format($sessionDetails['offset'] + $index + 1) ?></td><td><span class="usage-session-time"><?= nawa_usage_e(nawa_usage_session_time($session['acctstarttime'])) ?></span></td><td><?php if ($isOpen): ?><span>لم تُسجل نهاية</span><small class="usage-session-sub">آخر تحديث: <bdi><?= nawa_usage_e(nawa_usage_session_time($session['acctupdatetime'])) ?></bdi></small><?php else: ?><span class="usage-session-time"><?= nawa_usage_e(nawa_usage_session_time($session['acctstoptime'])) ?></span><?php endif; ?></td><td><span class="usage-session-status <?= $isOpen ? 'open' : '' ?>"><?= $isOpen ? 'مفتوحة' : 'منتهية' ?></span></td><td><bdi><?= nawa_usage_e(nawa_usage_human($session['download_bytes'])) ?></bdi></td><td><bdi><?= nawa_usage_e(nawa_usage_human($session['upload_bytes'])) ?></bdi></td><td class="total"><bdi><?= nawa_usage_e(nawa_usage_human(max(0, (int) $session['download_bytes']) + max(0, (int) $session['upload_bytes']))) ?></bdi></td></tr>
  <?php endforeach; endif; ?>
  </tbody></table></div>
  <?php if ($sessionDetails !== null && $sessionDetails['pages'] > 1): ?><nav class="usage-session-pager" aria-label="صفحات الجلسات"><?php if ($sessionDetails['page'] > 1): ?><a class="nawa-button" data-usage-link href="<?= nawa_usage_e($usageBaseUrl . '&day=' . $selectedDay . '&session_page=' . ($sessionDetails['page'] - 1)) ?>">السابق</a><?php endif; ?><span><?= $sessionDetails['page'] ?> / <?= $sessionDetails['pages'] ?></span><?php if ($sessionDetails['page'] < $sessionDetails['pages']): ?><a class="nawa-button" data-usage-link href="<?= nawa_usage_e($usageBaseUrl . '&day=' . $selectedDay . '&session_page=' . ($sessionDetails['page'] + 1)) ?>">التالي</a><?php endif; ?></nav><?php endif; ?>
  </section>
  <?php else: ?>
  <section class="usage-summary">
    <article class="usage-metric"><span>إجمالي الفترة <i class="bi bi-bar-chart-line"></i></span><strong><?= nawa_usage_e(nawa_usage_human($report['total'])) ?></strong><small><?= number_format(count($report['days'])) ?> يوم في التقرير</small></article>
    <article class="usage-metric"><span>التنزيل <i class="bi bi-arrow-down"></i></span><strong><?= nawa_usage_e(nawa_usage_human($report['total_download'])) ?></strong><small><?= $report['total'] > 0 ? number_format(($report['total_download'] / $report['total']) * 100, 1) : '0.0' ?>% من الاستخدام</small></article>
    <article class="usage-metric"><span>الرفع <i class="bi bi-arrow-up"></i></span><strong><?= nawa_usage_e(nawa_usage_human($report['total_upload'])) ?></strong><small><?= $report['total'] > 0 ? number_format(($report['total_upload'] / $report['total']) * 100, 1) : '0.0' ?>% من الاستخدام</small></article>
    <article class="usage-metric"><span>أعلى يوم <i class="bi bi-graph-up-arrow"></i></span><strong><?= nawa_usage_e(nawa_usage_human($report['peak']['total_bytes'] ?? 0)) ?></strong><small><?= !empty($report['peak']['date']) ? nawa_usage_e($report['peak']['date']) : 'لا يوجد استهلاك' ?></small></article>
  </section>

  <?php if ($quota > 0): $usedPercent = min(100, max(0, ($used / $quota) * 100)); ?>
  <section class="usage-card"><header class="usage-card-head"><div><h2>ملخص الباقة الحالية</h2><p>الرصيد الفعلي المسجل على حساب المشترك الآن</p></div></header><div class="usage-quota"><div class="usage-quota-copy"><div><span>حجم الباقة</span><b><?= nawa_usage_e(nawa_usage_human($quota)) ?></b></div><div><span>المستهلك الفعلي</span><b><?= nawa_usage_e(nawa_usage_human($used)) ?></b></div><div class="usage-quota-track"><i style="width:<?= number_format($usedPercent, 2, '.', '') ?>%"></i></div><div><span>المتبقي</span><b><?= nawa_usage_e(nawa_usage_human($remaining)) ?></b></div></div><div class="usage-quota-number"><strong><?= number_format($usedPercent, 1) ?>%</strong><small>من الباقة مستخدم</small></div></div></section>
  <?php endif; ?>

  <section class="usage-card usage-trading-card"><header class="usage-card-head"><div><h2>حركة الاستخدام اليومية</h2><p>مخطط تفاعلي يوضح حركة التنزيل والرفع خلال الفترة</p></div><div class="usage-legend trading-legend"><span><i></i> تنزيل</span><span><i></i> رفع</span></div></header><div class="usage-trading-scroll"><svg class="usage-trading-chart" viewBox="0 0 <?= $chartWidth ?> <?= $chartHeight ?>" role="img" aria-label="مخطط حركة الاستخدام اليومي" preserveAspectRatio="none"><defs><linearGradient id="usageDownloadArea" x1="0" x2="0" y1="0" y2="1"><stop offset="0%" stop-color="#527fe0" stop-opacity=".28"/><stop offset="100%" stop-color="#527fe0" stop-opacity=".015"/></linearGradient></defs><g class="trading-grid"><?php for ($gridIndex = 0; $gridIndex < 5; $gridIndex++): $gridY = $chartPaddingTop + (($chartPlotHeight / 4) * $gridIndex); ?><line x1="<?= $chartPaddingX ?>" x2="<?= $chartWidth - $chartPaddingX ?>" y1="<?= number_format($gridY, 2, '.', '') ?>" y2="<?= number_format($gridY, 2, '.', '') ?>"/><?php endfor; ?></g><polygon class="trading-area" points="<?= nawa_usage_e($downloadAreaPoints) ?>"/><polyline class="trading-line download-line" points="<?= implode(' ', $downloadPoints) ?>"/><polyline class="trading-line upload-line" points="<?= implode(' ', $uploadPoints) ?>"/><?php foreach ($chartDots as $dot): $chartDay = $dot['day']; ?><a class="trading-point" data-usage-link href="<?= nawa_usage_e($usageBaseUrl . '&day=' . $chartDay['date']) ?>" aria-label="<?= nawa_usage_e('عرض جلسات ' . nawa_usage_weekday($chartDay['date']) . ' ' . $chartDay['date']) ?>"><title><?= nawa_usage_e($chartDay['date'] . ' — تنزيل ' . nawa_usage_human($chartDay['download_bytes']) . '، رفع ' . nawa_usage_human($chartDay['upload_bytes'])) ?></title><circle class="trading-hit" cx="<?= number_format($dot['x'], 2, '.', '') ?>" cy="<?= number_format(($dot['download_y'] + $dot['upload_y']) / 2, 2, '.', '') ?>" r="22"/><circle class="trading-dot download-dot" cx="<?= number_format($dot['x'], 2, '.', '') ?>" cy="<?= number_format($dot['download_y'], 2, '.', '') ?>" r="4"/><circle class="trading-dot upload-dot" cx="<?= number_format($dot['x'], 2, '.', '') ?>" cy="<?= number_format($dot['upload_y'], 2, '.', '') ?>" r="3.5"/><text class="trading-date" x="<?= number_format($dot['x'], 2, '.', '') ?>" y="<?= $chartHeight - 13 ?>"><?= nawa_usage_e($chartDay['label']) ?></text></a><?php endforeach; ?></svg></div></section>

  <section class="usage-card"><header class="usage-card-head"><div><h2>تفاصيل الأيام</h2><p><?= number_format($report['active_days']) ?> أيام فيها استخدام · <?= number_format($report['sessions']) ?> جلسة</p></div></header><div class="usage-table-wrap"><table class="usage-table"><thead><tr><th>اليوم والتاريخ</th><th>التنزيل</th><th>الرفع</th><th>إجمالي اليوم</th><th>الجلسات</th></tr></thead><tbody><?php foreach ($daysReversed as $day): ?><tr><td><a class="usage-day-link" data-usage-link href="<?= nawa_usage_e($usageBaseUrl . '&day=' . $day['date']) ?>"><span><?= nawa_usage_e(nawa_usage_weekday($day['date'])) ?></span><bdi><?= nawa_usage_e($day['date']) ?></bdi><small>عرض الجلسات <i class="bi bi-chevron-left"></i></small></a></td><td><?= nawa_usage_e(nawa_usage_human($day['download_bytes'])) ?></td><td><?= nawa_usage_e(nawa_usage_human($day['upload_bytes'])) ?></td><td class="<?= $day['total_bytes'] > 0 ? 'total' : 'usage-zero' ?>"><?= nawa_usage_e(nawa_usage_human($day['total_bytes'])) ?></td><td><?= number_format($day['session_count']) ?></td></tr><?php endforeach; ?></tbody></table></div></section>
  <?php endif; ?>
  <div class="usage-note"><i class="bi bi-info-circle"></i><span>يُحسب الاستهلاك من سجلات المحاسبة الفعلية RADIUS. التقرير يوضح حركة البيانات المسجلة لكل يوم، بينما ملخص الباقة يعرض الرصيد الحالي الفعلي للحساب.</span></div>
</div>
<script>
(function(){var form=document.getElementById('usage-period-form');if(!form)return;form.closest('.usage-page').querySelectorAll('[data-usage-link]').forEach(function(link){link.addEventListener('click',function(event){if(event.ctrlKey||event.metaKey||event.shiftKey||event.altKey)return;event.preventDefault();loadSection(link.getAttribute('href'));});});var username=form.querySelector('[name="username"]').value;var usageContext=<?= json_encode($usageContext, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>;function ymd(date){return date.getFullYear()+'-'+String(date.getMonth()+1).padStart(2,'0')+'-'+String(date.getDate()).padStart(2,'0');}function openRange(from,to){loadSection('nawa-user-usage.php?fragment=1&username='+encodeURIComponent(username)+'&from='+encodeURIComponent(from)+'&to='+encodeURIComponent(to)+usageContext);}form.addEventListener('submit',function(event){event.preventDefault();openRange(form.querySelector('[name="from"]').value,form.querySelector('[name="to"]').value);});form.querySelectorAll('[data-usage-days]').forEach(function(button){button.addEventListener('click',function(){var days=Number(button.dataset.usageDays)||30;var to=new Date();var from=new Date(to);from.setDate(from.getDate()-(days-1));openRange(ymd(from),ymd(to));});});form.querySelectorAll('[data-usage-cycle]').forEach(function(button){button.addEventListener('click',function(){openRange(button.dataset.usageCycle,ymd(new Date()));});});})();
</script>
