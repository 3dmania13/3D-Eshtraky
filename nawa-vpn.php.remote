                  <i class="bi bi-ban"></i> حظر الآن
                  </button>
                </form>
              <?php endif; ?>

              <?php if (in_array($reviewStatus, ['blocked','blocked_confirmed'], true)): ?>
                <form method="post" action="nawa-vpn-api.php" style="display:inline-flex">
                  <input type="hidden" name="csrf_token" value="<?= vpn_e($csrf) ?>">
                  <input type="hidden" name="action" value="review_detected_domain">
