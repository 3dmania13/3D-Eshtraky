    </div>
  </section>

  <section class="vpn-card"><header class="vpn-card-head"><div><h2>سجل عمليات VPN</h2><p>آخر تغييرات ومزامنات الصفحة.</p></div><span><?= vpn_e($settings['last_sync_message'] ?: 'لا توجد مزامنة سابقة') ?></span></header><div class="vpn-log"><?php if ($audit === []): ?><div class="vpn-empty">لا توجد عمليات مسجلة.</div><?php endif; ?><?php foreach ($audit as $row): ?><div class="vpn-log-row"><time><?= vpn_e($row['created_at']) ?></time><b class="<?= $row['result_status'] === 'success' ? 'ok' : 'error' ?>"><?= vpn_e($row['action_name']) ?></b><span><?= vpn_e($row['details']) ?></span></div><?php endforeach; ?></div></section>
</div>
<script>
(function(){
  var root=document.querySelector('[data-vpn-page]'); if(!root)return;
  var toast=root.querySelector('[data-vpn-toast]');
  function notify(message,error){toast.textContent=message;toast.className='vpn-toast show '+(error?'error':'ok');window.setTimeout(function(){toast.className='vpn-toast';},5000)}
  async function request(data){var response=await fetch('nawa-vpn-api.php',{method:'POST',body:data,credentials:'same-origin',cache:'no-store',headers:{'X-Requested-With':'XMLHttpRequest'}});var text=await response.text(),result;try{result=JSON.parse(text)}catch(parseError){throw new Error('الخادم أعاد استجابة غير صحيحة. أعد نشر ملفات VPN ثم حدّث الصفحة.')}if(!response.ok||!result.ok)throw new Error(result.message||'تعذر تنفيذ العملية.');return result}

  /* REVIEW_FORM_HANDLER_V2 */
  root.addEventListener('submit',async function(event){
    var form=event.target;
    if(!(form instanceof HTMLFormElement))return;

    var actionInput=form.querySelector('input[name="action"]');
    if(!actionInput)return;

    var action=actionInput.value;
    var actions=[
      'review_detected_domain',
      'approve_detected_allowlist',
      'confirm_detected_block',
      'reblock_detected_domain'
    ];

    if(actions.indexOf(action)===-1)return;

    event.preventDefault();
    event.stopImmediatePropagation();

    var button=form.querySelector('[type="submit"]');
    var row=form.closest('[data-review-item]');
    var domain=row?(row.dataset.reviewDomain||''):'';
    var reviewWindow=null;

    if(button)button.disabled=true;

    /*
     * Open a blank tab immediately so the browser popup blocker
     * allows us to redirect it after the server finishes syncing.
     */
    if(action==='review_detected_domain'&&domain){
      /* لا نفتح الموقع تلقائياً؛ الفتح يتم فقط من زر فتح الموقع. */
    }

    try{
      var result=await request(new FormData(form));

      notify(result.message||'تم تنفيذ العملية.',false);

      if(action==='review_detected_domain'){
        /* الموقع أصبح قيد الفحص ومفتوحاً مؤقتاً، بدون فتح تبويب تلقائياً. */
      }

      window.nawaFragmentCache&&window.nawaFragmentCache.clear();

      if(typeof window.loadSection==='function'){
        await window.loadSection('nawa-vpn.php?fragment=1');
      }else{
        window.setTimeout(function(){window.location.reload();},400);
      }
    }catch(error){
      if(reviewWindow&&!reviewWindow.closed)reviewWindow.close();
      notify(error.message||'تعذر تنفيذ العملية.',true);
      if(button)button.disabled=false;
    }
  },true);
  async function submit(form){var button=form.querySelector('[type="submit"]');if(button)button.disabled=true;try{var result=await request(new FormData(form));notify(result.message,false);window.nawaFragmentCache&&window.nawaFragmentCache.clear();await window.loadSection('nawa-vpn.php?fragment=1')}catch(error){notify(error.message||'تعذر تنفيذ العملية.',true);if(button)button.disabled=false}}
  root.querySelectorAll('[data-vpn-settings],[data-vpn-domain-form]').forEach(function(form){form.addEventListener('submit',function(event){event.preventDefault();event.stopImmediatePropagation();if(form.matches('[data-vpn-settings]')){var enabled=form.querySelector('[name="enabled"]');if(enabled&&!enabled.checked&&!window.confirm('مفتاح الحماية مقفول. حفظ هذه الإعدادات سيوقف الحماية ويعيد DNS السابق. هل تريد المتابعة؟'))return}submit(form)})});
  var scope=root.querySelector('[data-vpn-scope]'),scopeValue=root.querySelector('[data-vpn-scope-value]');function updateScope(){if(scopeValue)scopeValue.style.display=scope&&scope.value==='all'?'none':'grid'}if(scope){scope.addEventListener('change',updateScope);updateScope()}
  var domainSearch=root.querySelector('[data-vpn-domain-search]'),domainVisible=root.querySelector('[data-vpn-domain-visible]'),domainItems=Array.from(root.querySelectorAll('[data-vpn-domain-item]'));function filterDomains(){var query=(domainSearch?.value||'').trim().toLowerCase(),visible=0;domainItems.forEach(function(item){var show=!query||(item.dataset.domain||'').includes(query);item.hidden=!show;if(show)visible++});if(domainVisible)domainVisible.textContent=visible.toLocaleString('en-US')}if(domainSearch){domainSearch.addEventListener('input',filterDomains);filterDomains()}
  root.querySelector('[data-vpn-sync]')?.addEventListener('click',async function(){var button=this;if(!window.confirm('سيتم تطبيق السياسة المحفوظة على أجهزة MikroTik المحددة فقط. هل تريد المتابعة؟'))return;button.disabled=true;var data=new FormData();data.append('csrf_token',<?= json_encode($csrf, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>);data.append('action','sync');try{var result=await request(data);notify(result.message,false);window.nawaFragmentCache&&window.nawaFragmentCache.clear();await window.loadSection('nawa-vpn.php?fragment=1')}catch(error){notify(error.message||'تعذرت المزامنة.',true);button.disabled=false}});
  root.querySelector('[data-family-filter]')?.addEventListener('click',async function(){var button=this;if(!window.confirm('سيتم تفعيل DNS العائلي على أجهزة MikroTik المحددة وتطبيقه على جميع المشتركين النشطين. هل تريد المتابعة؟'))return;button.disabled=true;var data=new FormData();data.append('csrf_token',<?= json_encode($csrf, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>);data.append('action','enable_family_filter');try{var result=await request(data);notify(result.message,false);window.nawaFragmentCache&&window.nawaFragmentCache.clear();await window.loadSection('nawa-vpn.php?fragment=1')}catch(error){notify(error.message||'تعذر تفعيل الحماية العائلية.',true);button.disabled=false}});
  root.querySelector('[data-vpn-rollback]')?.addEventListener('click',async function(){var button=this;if(!window.confirm('سيتم إيقاف حماية 3D Radius واستعادة DNS السابق على كل الأجهزة المحددة. هل تريد التراجع؟'))return;if(!window.confirm('تأكيد أخير: لن تتأثر قواعد MikroTik الأخرى، وسيتم تعطيل قواعد 3D Radius فقط.'))return;button.disabled=true;var data=new FormData();data.append('csrf_token',<?= json_encode($csrf, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>);data.append('action','rollback');try{var result=await request(data);notify(result.message,false);window.nawaFragmentCache&&window.nawaFragmentCache.clear();await window.loadSection('nawa-vpn.php?fragment=1')}catch(error){notify(error.message||'تعذر إكمال التراجع.',true);button.disabled=false}});
  var reviewFilter='all',reviewSearch=root.querySelector('[data-review-search]'),reviewItems=Array.from(root.querySelectorAll('[data-review-item]'));
  function filterReview(){
    var query=(reviewSearch?.value||'').trim().toLowerCase();
    reviewItems.forEach(function(item){
      var status=item.dataset.reviewStatus||'pending',domain=item.dataset.reviewDomain||'';
      item.hidden=!((reviewFilter==='all'||status===reviewFilter)&&(!query||domain.includes(query)));
    });
  }
  root.querySelectorAll('[data-review-filter]').forEach(function(button){
    button.addEventListener('click',function(){
      root.querySelectorAll('[data-review-filter]').forEach(function(b){b.classList.remove('active')});
      button.classList.add('active');
      reviewFilter=button.dataset.reviewFilter||'all';
      filterReview();
    });
  });
  if(reviewSearch)reviewSearch.addEventListener('input',filterReview);

  root.addEventListener('click',async function(event){
    var target=event.target instanceof Element?event.target:null;
    if(!target)return;

    var button=target.closest('[data-review-action]');
    if(!button||!root.contains(button)||button.disabled)return;

    event.preventDefault();
    event.stopPropagation();

    var action=button.dataset.reviewAction,id=button.dataset.detectedId,domain=button.dataset.detectedDomain||'الموقع';
    var questions={
      review_detected_domain:'سيبقى '+domain+' محظورًا أثناء المراجعة. هل تريد وضعه قيد الفحص؟',
      approve_detected_allowlist:'تأكد أنك فحصت '+domain+' وأنه ليس موقعًا إباحيًا. سيتم فتحه للمشتركين ووضعه في قائمة السماح. هل تريد المتابعة؟',
      confirm_detected_block:'سيتم تأكيد أن '+domain+' يجب أن يبقى محظورًا. هل تريد المتابعة؟',
      reblock_detected_domain:'سيتم إزالة '+domain+' من قائمة السماح وإعادته للحظر على الشبكات. هل تريد المتابعة؟'
    };

    if(!window.confirm(questions[action]||'هل تريد تنفيذ العملية على '+domain+'؟'))return;

    var data=new FormData();
    data.append('csrf_token',<?= json_encode($csrf, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>);
    data.append('action',action);
    data.append('detected_id',id);
    button.disabled=true;

    try{
      var result=await request(data);
      notify(result.message,false);
      window.nawaFragmentCache&&window.nawaFragmentCache.clear();
      await window.loadSection('nawa-vpn.php?fragment=1');
    }catch(error){
      notify(error.message||'تعذر تنفيذ العملية.',true);
      button.disabled=false;
    }
  });

  root.querySelectorAll('[data-delete-domain]').forEach(function(button){button.addEventListener('click',async function(){if(!window.confirm('حذف الموقع من قائمة الحظر؟'))return;var data=new FormData();data.append('csrf_token',<?= json_encode($csrf, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?>);data.append('action','delete_domain');data.append('domain_id',button.dataset.deleteDomain);button.disabled=true;try{await request(data);window.nawaFragmentCache&&window.nawaFragmentCache.clear();await window.loadSection('nawa-vpn.php?fragment=1')}catch(error){notify(error.message||'تعذر الحذف.',true);button.disabled=false}})});

  /* NAWA_ADBLOCK_LIVE_STATS_20260919 */
  if(window.nawaAdblockStatsTimer){
    window.clearInterval(window.nawaAdblockStatsTimer);
    window.nawaAdblockStatsTimer=null;
  }

  function formatAdblockNumber(value){
    var number=Number(value);
    if(!Number.isFinite(number)||number<0)number=0;
    return Math.trunc(number).toLocaleString('en-US');
  }

  async function refreshAdblockStats(){
    try{
      var response=await fetch(
        'nawa-adblock-stats.php?_=' + Date.now(),
        {
          method:'GET',
          credentials:'same-origin',
          cache:'no-store',
          headers:{'X-Requested-With':'XMLHttpRequest'}
        }
      );

      if(!response.ok)return;

      var result=await response.json();
      if(!result||!result.ok)return;

      var currentRoot=document.querySelector('[data-vpn-page]');
      if(!currentRoot)return;

      var today=currentRoot.querySelector('[data-adblock-today]');
      var week=currentRoot.querySelector('[data-adblock-week]');
      var month=currentRoot.querySelector('[data-adblock-month]');

      if(today)today.textContent=formatAdblockNumber(result.today);
      if(week)week.textContent=formatAdblockNumber(result.week);
      if(month)month.textContent=formatAdblockNumber(result.month);
    }catch(error){
      /* Keep the last displayed values if the live request fails. */
    }
  }

  refreshAdblockStats();

  window.nawaAdblockStatsTimer=window.setInterval(
    refreshAdblockStats,
    5000
  );

})();
</script>
<?php if (!$fragmentMode) print_footer_and_html_epilogue(); ?>
