            data-review-domain="<?= vpn_e(strtolower((string) $detected['domain'])) ?>"
          >
            <div class="vpn-review-main">
              <b><?= vpn_e($detected['domain']) ?></b>
              <span class="vpn-review-status <?= vpn_e($reviewStatus) ?>"><?= vpn_e($reviewLabel) ?></span>
