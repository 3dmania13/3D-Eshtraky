        <?php foreach ($detectedDomains as $detected):
          $reviewStatus = (string) ($detected['status'] ?? 'pending');
          $reviewLabels = [
              'pending' => 'بانتظار الحظر',
              'blocked' => 'محظور تلقائيًا',
              'reviewing' => 'قيد المراجعة',
              'blocked_confirmed' => 'محظور مؤكد',
              'allowlisted' => 'مسموح',
          ];
          $reviewLabel = $reviewLabels[$reviewStatus] ?? $reviewStatus;
        ?>
          <div
            class="vpn-review-row"
            data-review-item
