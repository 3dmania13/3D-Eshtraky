                </span>
              <?php endif; ?>
            </div>

            <div class="vpn-review-actions">
              <?php if ($reviewStatus === 'pending'): ?>
                <form method="post" action="nawa-vpn-api.php" style="display:inline-flex">
                  <input type="hidden" name="csrf_token" value="<?= vpn_e($csrf) ?>">
