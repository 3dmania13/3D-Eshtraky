<?php

declare(strict_types=1);

include 'library/checklogin.php';
$operator = (string) ($_SESSION['operator_user'] ?? '');
include_once '../common/includes/config_read.php';
include '../common/includes/db_open.php';
include_once 'include/nawa/vpn.php';
include_once 'include/nawa/system-health.php';

$fragmentMode = ($_GET['fragment'] ?? '') === '1';
$ajaxMode = ($_GET['ajax'] ?? '') === '1';
$isManager = function_exists('nawa_health_manager') && nawa_health_manager($dbSocket);
nawa_vpn_schema($dbSocket);

function vpn_e($value): string { return htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8'); }

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $response = ['ok' => false, 'message' => 'تعذر تنفيذ الطلب.'];
    try {
        if (!$isManager) throw new RuntimeException('هذه الصفحة متاحة لمدير النظام فقط.');
        if (!nawa_vpn_check_csrf_token(isset($_POST['csrf_token']) ? (string) $_POST['csrf_token'] : null)) throw new RuntimeException('انتهت صلاحية الجلسة. حدّث الصفحة ثم حاول مرة أخرى.');
        $action = (string) ($_POST['action'] ?? '');
        if ($action === 'save_settings') {
            $enabled = isset($_POST['enabled']) ? 1 : 0;
            $mode = in_array((string) ($_POST['mode'] ?? ''), ['dns', 'vpn'], true) ? (string) $_POST['mode'] : 'dns';
            $scopeType = in_array((string) ($_POST['scope_type'] ?? ''), ['all', 'group', 'user'], true) ? (string) $_POST['scope_type'] : 'all';
            $scopeValue = trim((string) ($_POST['scope_value'] ?? ''));
            if ($scopeType !== 'all' && $scopeValue === '') throw new RuntimeException('حدد اسم المستخدم أو المجموعة التي ستطبق عليها السياسة.');
            $nasIds = array_values(array_unique(array_filter(array_map('intval', (array) ($_POST['nas_ids'] ?? [])), static fn($id) => $id > 0)));
            if ($nasIds === []) throw new RuntimeException('اختر جهاز MikroTik واحدًا على الأقل.');
            $dbSocket->query("UPDATE nawa_vpn_settings SET enabled={$enabled},mode=" . nawa_vpn_q($dbSocket, $mode)
                . ',scope_type=' . nawa_vpn_q($dbSocket, $scopeType) . ',scope_value=' . nawa_vpn_q($dbSocket, $scopeValue)
                . ',nas_ids=' . nawa_vpn_q($dbSocket, json_encode($nasIds)) . ',updated_by=' . nawa_vpn_q($dbSocket, $operator) . ' WHERE id=1');
            nawa_vpn_audit($dbSocket, $operator, 'save_settings', $mode, 'success', 'enabled=' . $enabled . '; scope=' . $scopeType . ':' . $scopeValue);
            $response = ['ok' => true, 'message' => 'تم حفظ إعدادات VPN والحماية. اضغط مزامنة لتطبيقها الآن.'];
        } elseif ($action === 'add_domain') {
            $domain = nawa_vpn_normalize_domain((string) ($_POST['domain'] ?? ''));
            $category = trim((string) ($_POST['category'] ?? 'custom')) ?: 'custom';
            $result = $dbSocket->query('INSERT INTO nawa_vpn_domains (domain,category,created_by) VALUES (' . nawa_vpn_q($dbSocket, $domain) . ',' . nawa_vpn_q($dbSocket, mb_substr($category, 0, 50)) . ',' . nawa_vpn_q($dbSocket, $operator) . ')');
            if (DB::isError($result)) throw new RuntimeException('الموقع موجود مسبقًا أو تعذر حفظه.');
            nawa_vpn_audit($dbSocket, $operator, 'add_domain', $domain, 'success', 'Added to managed DNS block list.');
            $response = ['ok' => true, 'message' => 'تمت إضافة ' . $domain . ' إلى قائمة الحظر.'];
        } elseif ($action === 'delete_domain') {
            $id = max(0, (int) ($_POST['domain_id'] ?? 0));
            $domain = (string) $dbSocket->getOne("SELECT domain FROM nawa_vpn_domains WHERE id={$id}");
            if ($id <= 0 || $domain === '') throw new RuntimeException('الموقع المطلوب غير موجود.');
            $dbSocket->query("DELETE FROM nawa_vpn_domains WHERE id={$id}");
            nawa_vpn_audit($dbSocket, $operator, 'delete_domain', $domain, 'success', 'Removed from managed DNS block list.');
            $response = ['ok' => true, 'message' => 'تم حذف ' . $domain . ' من القائمة.'];
        } elseif ($action === 'sync') {
            $response = nawa_vpn_sync($dbSocket, $operator);
            $response['ok'] = count(array_filter((array) ($response['routers'] ?? []), static fn($row) => !empty($row['ok']))) > 0;
        } else throw new RuntimeException('الإجراء غير معروف.');
    } catch (Throwable $error) {
        $response = ['ok' => false, 'message' => $error->getMessage()];
        nawa_vpn_audit($dbSocket, $operator, (string) ($_POST['action'] ?? 'unknown'), '', 'error', $error->getMessage());
    }
    if ($ajaxMode || $fragmentMode) {
        http_response_code($response['ok'] ? 200 : 422);
        header('Content-Type: application/json; charset=utf-8');
        echo json_encode($response, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);
        exit;
    }
}

$settings = nawa_vpn_settings($dbSocket);
$domains = nawa_vpn_rows($dbSocket, 'SELECT * FROM nawa_vpn_domains ORDER BY created_at DESC,id DESC');
$detectedDomains = nawa_vpn_rows($dbSocket, "SELECT * FROM nawa_vpn_detected_domains ORDER BY last_seen_at DESC,id DESC");
$detectedCounts = [
    'pending' => 0,
    'blocked' => 0,
    'reviewing' => 0,
    'blocked_confirmed' => 0,
    'allowlisted' => 0,
];
foreach ($detectedDomains as $detectedRow) {
    $detectedStatus = (string) ($detectedRow['status'] ?? 'pending');
    if (isset($detectedCounts[$detectedStatus])) $detectedCounts[$detectedStatus]++;
}
$displayDomains = [];
foreach (nawa_vpn_family_domains() as $builtinDomain) {
    $displayDomains[$builtinDomain] = [
        'domain' => $builtinDomain,
        'category' => 'محتوى غير مناسب',
        'source' => 'قائمة حماية مدمجة',
        'created_at' => '',
        'manual_id' => 0,
        'builtin' => true,
    ];
}
foreach ($domains as $domainRow) {
    $domainName = strtolower(trim((string) ($domainRow['domain'] ?? '')));
    if ($domainName === '') continue;
    $categoryLabels = ['adult' => 'محتوى غير مناسب', 'malware' => 'برمجيات ضارة', 'gambling' => 'قمار', 'social' => 'تواصل اجتماعي', 'custom' => 'مخصص'];
    if (isset($displayDomains[$domainName])) {
        $displayDomains[$domainName]['source'] = 'مدمج + مضاف يدويًا';
        $displayDomains[$domainName]['manual_id'] = (int) ($domainRow['id'] ?? 0);
        $displayDomains[$domainName]['created_at'] = (string) ($domainRow['created_at'] ?? '');
    } else {
        $displayDomains[$domainName] = [
            'domain' => $domainName,
            'category' => $categoryLabels[(string) ($domainRow['category'] ?? 'custom')] ?? (string) ($domainRow['category'] ?? 'مخصص'),
            'source' => 'مضاف يدويًا',
            'created_at' => (string) ($domainRow['created_at'] ?? ''),
            'manual_id' => (int) ($domainRow['id'] ?? 0),
            'builtin' => false,
        ];
    }
}
$displayDomains = array_values($displayDomains);
usort($displayDomains, static fn($a, $b) => strcasecmp((string) $a['domain'], (string) $b['domain']));
$routers = nawa_vpn_rows($dbSocket, "SELECT id,nasname,shortname,type,api_username,api_user,COALESCE(api_port,8728) api_port FROM nas WHERE COALESCE(enabled,1)=1 AND LOWER(COALESCE(type,''))='mikrotik' ORDER BY shortname,nasname");
$audit = nawa_vpn_rows($dbSocket, 'SELECT operator_name,action_name,target_value,result_status,details,created_at FROM nawa_vpn_audit ORDER BY id DESC LIMIT 12');
$groups = nawa_vpn_rows($dbSocket, 'SELECT DISTINCT groupname FROM radusergroup WHERE groupname IS NOT NULL AND groupname<>\'\' ORDER BY groupname LIMIT 500');
$activeAddresses = nawa_vpn_active_addresses($dbSocket, (string) $settings['scope_type'], (string) $settings['scope_value']);
$csrf = nawa_vpn_csrf_token();

/* NAWA_ADBLOCK_COUNTER_20260919 */
$adblockToday = 0;
$adblockCounterFile = '/var/lib/3dradius/adblock-counter/stats.json';

if (is_readable($adblockCounterFile)) {
    $adblockCounterRaw = @file_get_contents($adblockCounterFile);

    if (is_string($adblockCounterRaw) && $adblockCounterRaw !== '') {
        $adblockCounterData = json_decode($adblockCounterRaw, true);

        if (
            is_array($adblockCounterData)
            && ($adblockCounterData['date'] ?? '') === date('Y-m-d')
        ) {
            $adblockToday = max(
                0,
                (int)($adblockCounterData['today'] ?? 0)
            );
        }
    }
}

if (!$fragmentMode) {
    include_once 'lang/main.php';
    include '../common/includes/layout.php';
    print_html_prologue('VPN', $langCode, ['static/css/nawa-production.css']);
}
?>
<style>
.vpn-page{display:grid;gap:16px;color:#202538}.vpn-hero{display:flex;justify-content:space-between;gap:20px;align-items:center;padding:22px;border:1px solid #eadbd9;border-radius:18px;background:linear-gradient(135deg,#fff,#fff5f4)}.vpn-hero h1{margin:4px 0;font-size:28px}.vpn-hero p{margin:0;color:#737b8d;font-size:12px}.vpn-eyebrow{color:#e5221a!important;font-weight:900!important}.vpn-state{display:flex;align-items:center;gap:10px;padding:12px 15px;border-radius:13px;background:#fff;border:1px solid #ececf1}.vpn-state i{font-size:20px;color:#9aa1af}.vpn-state.on i{color:#10a879}.vpn-state span{display:grid;gap:2px}.vpn-state small{color:#9298a8;font-size:10px}.vpn-grid{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(310px,.65fr);gap:16px;align-items:start}.vpn-card{overflow:hidden;border:1px solid #e5e7ed;border-radius:16px;background:#fff;box-shadow:0 8px 28px rgba(23,31,50,.04)}.vpn-card-head{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:16px 18px;border-bottom:1px solid #eceef3}.vpn-card-head h2{margin:0;font-size:15px}.vpn-card-head p{margin:4px 0 0;color:#8a91a1;font-size:10px}.vpn-body{display:grid;gap:15px;padding:18px}.vpn-toggle{display:flex;align-items:center;justify-content:space-between;gap:15px;padding:14px;border:1px solid #e7e9ef;border-radius:13px}.vpn-toggle span{display:grid;gap:3px}.vpn-toggle small{color:#8a91a2;font-size:10px}.vpn-switch{position:relative;width:48px;height:27px}.vpn-switch input{position:absolute;opacity:0}.vpn-switch i{display:block;width:100%;height:100%;border-radius:999px;background:#cfd3dc;transition:.2s}.vpn-switch i:after{content:"";position:absolute;top:4px;right:4px;width:19px;height:19px;border-radius:50%;background:#fff;box-shadow:0 2px 5px #0002;transition:.2s}.vpn-switch input:checked+i{background:#e5221a}.vpn-switch input:checked+i:after{transform:translateX(-21px)}.vpn-modes{display:grid;grid-template-columns:1fr 1fr;gap:10px}.vpn-mode{position:relative}.vpn-mode input{position:absolute;opacity:0}.vpn-mode span{display:grid;gap:5px;height:100%;padding:15px;border:1px solid #e4e6ec;border-radius:13px;cursor:pointer}.vpn-mode i{font-size:20px;color:#e5221a}.vpn-mode b{font-size:12px}.vpn-mode small{color:#8990a0;font-size:9px;line-height:1.6}.vpn-mode input:checked+span{border-color:#e5221a;background:#fff5f4;box-shadow:0 0 0 2px #fee2e0}.vpn-fields{display:grid;grid-template-columns:1fr 1fr;gap:10px}.vpn-field{display:grid;gap:6px}.vpn-field.full{grid-column:1/-1}.vpn-field>span{font-size:10px;font-weight:900}.vpn-field input,.vpn-field select{min-height:42px;padding:8px 11px;border:1px solid #dfe2e9;border-radius:10px;background:#fff;font:inherit;font-size:11px}.vpn-routers{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.vpn-router{display:flex;align-items:center;gap:9px;padding:11px;border:1px solid #e6e8ee;border-radius:11px}.vpn-router input{accent-color:#e5221a}.vpn-router span{display:grid}.vpn-router b{font-size:10px}.vpn-router small{font-size:9px;color:#8b92a1}.vpn-actions{display:flex;gap:9px;flex-wrap:wrap}.vpn-btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:39px;padding:8px 14px;border:1px solid #dfe2e9;border-radius:10px;background:#fff;color:#3b4150;font:inherit;font-size:10px;font-weight:900;cursor:pointer}.vpn-btn.primary{border-color:#e5221a;background:#e5221a;color:#fff}.vpn-btn:disabled{opacity:.55;cursor:wait}.vpn-note{display:flex;gap:9px;padding:12px;border:1px solid #f0d9ad;border-radius:11px;background:#fff9ed;color:#7e5e24;font-size:10px;line-height:1.7}.vpn-domain-form{display:grid;grid-template-columns:1fr 120px auto;gap:8px}.vpn-domain-tools{display:flex;align-items:center;gap:8px}.vpn-domain-search{flex:1;min-height:40px;padding:8px 12px;border:1px solid #dfe2e9;border-radius:10px;font:inherit;font-size:10px;direction:ltr}.vpn-domain-count{white-space:nowrap;color:#72798a;font-size:9px}.vpn-domain-info{padding:10px 12px;border:1px solid #cbe4f7;border-radius:10px;background:#f2f9fe;color:#35647d;font-size:9px;line-height:1.65}.vpn-domain-list{display:grid;gap:7px;max-height:470px;overflow:auto}.vpn-domain{display:flex;align-items:center;gap:10px;padding:11px;border:1px solid #e9eaf0;border-radius:10px}.vpn-domain[hidden]{display:none}.vpn-domain>i{display:grid;place-items:center;width:32px;height:32px;border-radius:9px;background:#fff0ef;color:#e5221a}.vpn-domain.builtin>i{background:#effbf7;color:#0a9f76}.vpn-domain div{display:grid;gap:2px;min-width:0;flex:1}.vpn-domain b{font-size:11px;direction:ltr;text-align:right;overflow:hidden;text-overflow:ellipsis}.vpn-domain small{font-size:9px;color:#9298a8}.vpn-domain button{width:32px;height:32px;padding:0;color:#d52a24}.vpn-empty{padding:25px;text-align:center;color:#9298a8;font-size:11px}.vpn-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.vpn-stat{padding:12px;border-radius:11px;background:#f7f8fa}.vpn-stat span{display:block;color:#8c93a2;font-size:9px}.vpn-stat b{display:block;margin-top:5px;font-size:17px}.vpn-log{display:grid;gap:0}.vpn-log-row{display:grid;grid-template-columns:105px 90px 1fr;gap:10px;padding:11px 15px;border-top:1px solid #eef0f4;font-size:9px}.vpn-log-row time{direction:ltr;color:#8b92a1}.vpn-log-row b.ok{color:#079669}.vpn-log-row b.error{color:#d92d20}.vpn-toast{display:none;padding:12px 14px;border-radius:11px;font-size:11px;font-weight:800}.vpn-toast.show{display:block}.vpn-toast.ok{border:1px solid #a9e6d4;background:#effbf7;color:#087b5e}.vpn-toast.error{border:1px solid #fac5c2;background:#fff1f0;color:#b42318}@media(max-width:950px){.vpn-grid{grid-template-columns:1fr}}@media(max-width:650px){.vpn-hero{align-items:flex-start;flex-direction:column}.vpn-modes,.vpn-fields,.vpn-routers,.vpn-stats{grid-template-columns:1fr}.vpn-domain-form{grid-template-columns:1fr}.vpn-domain-tools{align-items:stretch;flex-direction:column}.vpn-log-row{grid-template-columns:1fr}.vpn-field.full{grid-column:auto}}
.vpn-family{display:flex;align-items:center;gap:12px;width:100%;padding:14px;border:1px solid #f3b4af;border-radius:13px;background:linear-gradient(135deg,#fff1f0,#fff8f7);color:#a9211b;text-align:right;cursor:pointer}.vpn-family>i:first-child{display:grid;place-items:center;flex:0 0 40px;width:40px;height:40px;border-radius:11px;background:#e5221a;color:#fff;font-size:18px}.vpn-family span{display:grid;gap:3px;flex:1}.vpn-family b{font-size:12px}.vpn-family small{color:#8d5d59;font-size:9px;line-height:1.55}.vpn-family.active{border-color:#9fdfcb;background:#effbf7;color:#087b5e}.vpn-family.active>i:first-child{background:#0ba77b}.vpn-family:disabled{opacity:.6;cursor:not-allowed}
.vpn-review-head{display:flex;align-items:center;gap:9px;flex-wrap:wrap}
.vpn-review-filter{display:inline-flex;align-items:center;gap:6px;min-height:36px;padding:7px 11px;border:1px solid #e2e5eb;border-radius:9px;background:#fff;color:#555d6d;font:inherit;font-size:9px;font-weight:900;cursor:pointer}
.vpn-review-filter.active{border-color:#e5221a;background:#fff2f1;color:#b42318}
.vpn-review-search{min-height:38px;min-width:220px;padding:8px 11px;border:1px solid #dfe2e9;border-radius:10px;font:inherit;font-size:10px;direction:ltr}
.vpn-review-list{display:grid;gap:8px;max-height:650px;overflow:auto}
.vpn-review-row{display:grid;grid-template-columns:minmax(180px,1.2fr) minmax(180px,.8fr) auto;gap:12px;align-items:center;padding:12px;border:1px solid #e8eaf0;border-radius:11px}
.vpn-review-row[hidden]{display:none}
.vpn-review-main{display:grid;gap:4px;min-width:0}
.vpn-review-main b{direction:ltr;text-align:right;font-size:11px;overflow:hidden;text-overflow:ellipsis}
.vpn-review-main small{font-size:9px;color:#8c93a2;line-height:1.55}
.vpn-review-meta{display:grid;gap:4px;font-size:9px;color:#747b8b}
.vpn-review-actions{display:flex;align-items:center;gap:6px;flex-wrap:wrap;justify-content:flex-end}
.vpn-review-status{display:inline-flex;align-items:center;justify-content:center;width:max-content;padding:5px 8px;border-radius:999px;font-size:8px;font-weight:900}
.vpn-review-status.pending{background:#fff7e6;color:#9a6700}
.vpn-review-status.blocked{background:#fff0ef;color:#b42318}
.vpn-review-status.reviewing{background:#eef4ff;color:#3448a8}
.vpn-review-status.blocked_confirmed{background:#fdecec;color:#8f1712}
.vpn-review-status.allowlisted{background:#ecfdf5;color:#087b5e}
.vpn-btn.safe{border-color:#a7e3d1;color:#087b5e;background:#f0fbf7}
.vpn-btn.danger{border-color:#f1b7b3;color:#b42318;background:#fff5f4}
@media(max-width:750px){.vpn-review-row{grid-template-columns:1fr}.vpn-review-actions{justify-content:flex-start}.vpn-review-search{width:100%;min-width:0}}
</style>
<style>
/* VPN protection dashboard refresh */
.vpn-page{color:var(--nawa-ink,#142b50);gap:14px}.vpn-hero{position:relative;overflow:hidden;min-height:150px;padding:24px 28px;border-color:#c9e0ff;background:radial-gradient(circle at 52% 45%,#d7ecff 0,transparent 27%),linear-gradient(120deg,#f9fcff,#e5f2ff 54%,#f6fbff)}.vpn-hero:before{content:"";position:absolute;width:270px;height:270px;left:34%;bottom:-165px;border-radius:50%;background:#1976ed20}.vpn-hero>div{position:relative}.vpn-eyebrow{display:none}.vpn-hero h1{color:#0a347d;font-size:30px}.vpn-hero p{color:#5272a1}.vpn-hero-art{display:flex;align-items:flex-end;justify-content:center;width:270px;height:130px}.vpn-hero-art .vpn-globe{position:absolute;width:68px;height:68px;margin-left:-115px;margin-bottom:3px;border:3px solid #25aaf5;border-radius:50%;background:repeating-linear-gradient(0deg,transparent 0 14px,#25aaf555 15px 16px),repeating-linear-gradient(90deg,transparent 0 16px,#25aaf555 17px 18px);box-shadow:inset 0 0 20px #32aefa77,0 8px 20px #1279da35}.vpn-hero-art .vpn-shield{z-index:2;display:grid;place-items:center;width:91px;height:110px;color:#fff;border:5px solid #84c9ff;border-radius:45% 45% 55% 55%/35% 35% 65% 65%;background:linear-gradient(135deg,#3e9bff,#0754d9);font-size:43px;box-shadow:0 14px 28px #1268d855}.vpn-hero-art .vpn-server{position:absolute;width:74px;height:70px;margin-right:-122px;margin-bottom:2px;border-radius:8px;background:repeating-linear-gradient(0deg,#173b70 0 19px,#071e47 20px 22px);box-shadow:0 12px 22px #082e6d44}.vpn-hero-art .vpn-server:after{content:"•  •";color:#22e39b;letter-spacing:8px;margin:8px;font-size:10px}.vpn-state{min-width:190px;border-color:#d7e8f8;background:#ffffffcf}.vpn-state i{color:#10ba75!important;font-size:35px}.vpn-stats{grid-template-columns:repeat(5,minmax(0,1fr));gap:11px}.vpn-stat{position:relative;padding:15px 14px;border:1px solid #d9e7f7;border-radius:14px;background:#fff;box-shadow:0 7px 20px #235d9e0b}.vpn-stat:before{content:"";display:block;width:34px;height:34px;margin-bottom:9px;border-radius:10px;background:#e5f1ff}.vpn-stat:nth-child(1):before{background:#ffe5e8}.vpn-stat:nth-child(2):before{background:#eee5ff}.vpn-stat:nth-child(3):before{background:#e3f8ef}.vpn-stat:nth-child(4):before{background:#fff1df}.vpn-stat:nth-child(5):before{background:#e5f1ff}.vpn-stat b{color:#102e65;font-size:20px}.vpn-card{border-color:#dbe8f7;border-radius:16px;box-shadow:0 9px 26px #1a4f8b0d}.vpn-card-head{background:linear-gradient(90deg,#fbfdff,#f3f8ff);border-bottom-color:#e3edf8}.vpn-card-head h2{color:#153b79}.vpn-switch input:checked+i{background:#0fbd78}.vpn-mode i{color:#0877ec}.vpn-mode input:checked+span{border-color:#1884ee;background:#f0f8ff;box-shadow:0 0 0 2px #dcedff}.vpn-btn.primary{border-color:#0878ed;background:linear-gradient(135deg,#118af4,#075be0)}.vpn-router input{accent-color:#0d7fed}.vpn-note{border-color:#f4d38b;background:#fff9eb;color:#805b12}.vpn-family{border-color:#b5e5d5;background:linear-gradient(135deg,#effbf7,#f8fffd);color:#087b5e}.vpn-family>i:first-child{background:#0ab77d}.vpn-review-filter.active{border-color:#1684ee;background:#eff7ff;color:#075bd8}html[data-theme="dark"] .vpn-hero,body.dark .vpn-hero{border-color:#174f89;background:radial-gradient(circle at 52% 45%,#0d579b 0,transparent 29%),linear-gradient(120deg,#082348,#061730 54%,#0b274d)}html[data-theme="dark"] .vpn-hero h1,body.dark .vpn-hero h1{color:#e5f1ff}html[data-theme="dark"] .vpn-hero p,body.dark .vpn-hero p{color:#a8c9ef}html[data-theme="dark"] .vpn-state,body.dark .vpn-state{border-color:#214d7c;background:#102c51}html[data-theme="dark"] .vpn-stat,body.dark .vpn-stat{border-color:#21466e;background:#0d2948}html[data-theme="dark"] .vpn-stat b,body.dark .vpn-stat b{color:#eef6ff}html[data-theme="dark"] .vpn-card-head,body.dark .vpn-card-head{background:#102b4c;border-color:#21466e}@media(max-width:1050px){.vpn-stats{grid-template-columns:repeat(3,1fr)}.vpn-hero-art{display:none}}@media(max-width:650px){.vpn-stats{grid-template-columns:1fr 1fr}.vpn-state{width:100%}}
