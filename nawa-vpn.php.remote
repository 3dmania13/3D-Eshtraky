                  <input type="hidden" name="action" value="approve_detected_allowlist">
                  <input type="hidden" name="detected_id" value="<?= (int) $detected['id'] ?>">
                  <button class="vpn-btn safe" type="submit" onclick="return window.confirm('سيتم فتح الموقع واعتماده كمسموح. هل أنت متأكد؟')" >
